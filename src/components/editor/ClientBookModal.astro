---
// ClientBookModal.astro - Quick Client Address Book with Full Details (Name, Address, GST/Tax ID)
---

<div id="client-book-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4 no-print">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-xl w-full overflow-hidden flex flex-col max-h-[85vh] animate-scale-in">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717]">Client Address Book</h3>
          <p class="text-xs text-[#888888]">1-Click autofill for repeat clients (Name, Address, GST/Tax)</p>
        </div>
      </div>
      <button id="btn-close-client-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Quick Save Current & Add Form Accordion -->
    <div class="p-4 border-b border-[#ebebeb] bg-[#fafafa] space-y-3">
      <div class="flex items-center justify-between gap-2">
        <input
          id="client-search-input"
          type="text"
          placeholder="Search saved clients..."
          class="flex-1 px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white text-[#171717] focus:outline-hidden focus:border-[#171717]"
        />
        <button id="btn-save-current-client" type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors cursor-pointer shrink-0">
          + Save Current Client
        </button>
      </div>

      <!-- Add Custom Client Details -->
      <details id="details-custom-client" class="group">
        <summary class="text-xs text-[#0070f3] hover:underline cursor-pointer select-none font-medium flex items-center gap-1">
          <span>+ Add Custom Client Profile</span>
          <span class="text-[10px] text-[#888888] group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-3 space-y-2 text-xs">
          <div>
            <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Client / Company Name *</label>
            <input id="cb-new-name" type="text" placeholder="e.g. Acme Corp" class="w-full px-2.5 py-1.5 rounded-lg border border-[#ebebeb] bg-white text-[#171717]" />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Email</label>
              <input id="cb-new-email" type="email" placeholder="billing@client.com" class="w-full px-2.5 py-1.5 rounded-lg border border-[#ebebeb] bg-white text-[#171717]" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Phone</label>
              <input id="cb-new-phone" type="text" placeholder="+1 (555) 000-0000" class="w-full px-2.5 py-1.5 rounded-lg border border-[#ebebeb] bg-white text-[#171717]" />
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Client Full Address</label>
            <textarea id="cb-new-address" rows="2" placeholder="Street Address, City, State, ZIP" class="w-full px-2.5 py-1.5 rounded-lg border border-[#ebebeb] bg-white text-[#171717] resize-none"></textarea>
          </div>
          <div>
            <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">GST / Tax ID Number</label>
            <input id="cb-new-taxid" type="text" placeholder="e.g. 27AAAAA0000A1Z5 or US-TAX-998" class="w-full px-2.5 py-1.5 rounded-lg border border-[#ebebeb] bg-white text-[#171717] font-mono" />
          </div>
          <div class="flex justify-end pt-1">
            <button id="btn-save-custom-client-form" type="button" class="px-3.5 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors cursor-pointer">
              Add to Address Book
            </button>
          </div>
        </div>
      </details>
    </div>

    <!-- Client List -->
    <div id="client-book-list" class="p-6 overflow-y-auto space-y-3 flex-1">
      <!-- Populated via JS -->
    </div>
  </div>
</div>
