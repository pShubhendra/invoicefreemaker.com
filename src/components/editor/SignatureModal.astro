---
// SignatureModal.astro - Studio for Drawing, Typing & Uploading Digital Signatures
---

<div id="signature-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-xs p-4 no-print flex items-center justify-center">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-xl w-full overflow-hidden flex flex-col max-h-[85vh] m-auto animate-scale-in dark:bg-[#111] dark:border-neutral-800">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa] dark:border-neutral-800 dark:bg-neutral-900">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717] dark:text-neutral-100">Digital Signature Studio</h3>
          <p class="text-xs text-[#888888] dark:text-neutral-400">Add an authentic, legally valid signature to your invoice</p>
        </div>
      </div>
      <button id="btn-close-sig-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="px-6 pt-4 pb-2 bg-white dark:bg-[#111]">
      <div class="flex items-center p-1 rounded-xl bg-[#f5f5f5] text-xs font-medium dark:bg-neutral-800/80">
        <button id="sig-tab-draw" type="button" class="flex-1 py-1.5 rounded-lg bg-white text-[#171717] shadow-xs transition-all cursor-pointer text-center dark:bg-[#111] dark:text-neutral-100">
          Draw Signature
        </button>
        <button id="sig-tab-type" type="button" class="flex-1 py-1.5 rounded-lg text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer text-center dark:text-neutral-400 dark:hover:text-neutral-100">
          Type Signature
        </button>
        <button id="sig-tab-upload" type="button" class="flex-1 py-1.5 rounded-lg text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer text-center dark:text-neutral-400 dark:hover:text-neutral-100">
          Upload Image
        </button>
      </div>
    </div>

    <!-- Tab Contents -->
    <div class="p-6 space-y-4 flex-1 overflow-y-auto">
      <!-- 1. Draw Tab -->
      <div id="sig-content-draw" class="space-y-3">
        <div class="border border-[#ebebeb] rounded-xl bg-[#fafafa] p-1 relative dark:border-neutral-700 dark:bg-neutral-800/60">
          <canvas id="sig-canvas" width="500" height="160" class="w-full h-40 bg-white rounded-lg cursor-crosshair touch-none"></canvas>
          <div class="absolute bottom-2 right-2 flex items-center gap-1.5">
            <button id="btn-undo-sig" type="button" class="px-2 py-1 text-[11px] font-medium bg-white/90 border border-[#ebebeb] rounded shadow-2xs hover:bg-white text-[#4d4d4d] cursor-pointer dark:bg-neutral-700/90 dark:border-neutral-600 dark:hover:bg-neutral-700 dark:text-neutral-300">Undo</button>
            <button id="btn-clear-sig" type="button" class="px-2 py-1 text-[11px] font-medium bg-white/90 border border-[#ebebeb] rounded shadow-2xs hover:bg-white text-red-600 cursor-pointer dark:bg-neutral-700/90 dark:border-neutral-600 dark:hover:bg-neutral-700">Clear</button>
          </div>
        </div>
      </div>

      <!-- 2. Type Tab -->
      <div id="sig-content-type" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-medium text-[#4d4d4d] mb-1 dark:text-neutral-400">Type Full Name</label>
          <input id="sig-typed-input" type="text" placeholder="e.g. Authorised Signatory" class="w-full px-3.5 py-2 text-sm rounded-xl border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717] dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:focus:border-neutral-400" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <label class="sig-font-card p-3 rounded-xl border border-[#ebebeb] hover:border-[#171717] cursor-pointer bg-[#fafafa] flex flex-col justify-between h-20 transition-all ring-2 ring-[#171717] dark:border-neutral-700 dark:hover:border-neutral-400 dark:bg-neutral-800 dark:ring-neutral-400">
            <input type="radio" name="sig-font-choice" value="Caveat" checked class="hidden" />
            <span class="text-[10px] text-[#888888] font-mono dark:text-neutral-500">Caveat</span>
            <span id="preview-font-1" class="text-xl font-['Caveat'] text-[#171717] truncate dark:text-neutral-100">Authorised Signatory</span>
          </label>
          <label class="sig-font-card p-3 rounded-xl border border-[#ebebeb] hover:border-[#171717] cursor-pointer bg-[#fafafa] flex flex-col justify-between h-20 transition-all dark:border-neutral-700 dark:hover:border-neutral-400 dark:bg-neutral-800">
            <input type="radio" name="sig-font-choice" value="Dancing Script" class="hidden" />
            <span class="text-[10px] text-[#888888] font-mono dark:text-neutral-500">Dancing Script</span>
            <span id="preview-font-2" class="text-xl font-['Dancing_Script'] text-[#171717] truncate dark:text-neutral-100">Authorised Signatory</span>
          </label>
        </div>
      </div>

      <!-- 3. Upload Tab -->
      <div id="sig-content-upload" class="hidden space-y-3">
        <label class="border-2 border-dashed border-[#ebebeb] hover:border-[#171717] rounded-xl p-6 flex flex-col items-center justify-center cursor-pointer transition-colors bg-[#fafafa] dark:border-neutral-700 dark:hover:border-neutral-400 dark:bg-neutral-800/60">
          <span class="text-xs font-medium text-[#171717] dark:text-neutral-100">Click to upload PNG or JPG</span>
          <span class="text-[11px] text-[#888888] mt-0.5 dark:text-neutral-500">Transparent background recommended</span>
          <input id="sig-file-input" type="file" accept="image/*" class="hidden" />
        </label>
        <div id="sig-upload-preview" class="hidden">
          <p class="text-xs font-medium text-[#4d4d4d] mb-2 dark:text-neutral-400">Preview</p>
          <div class="border border-[#ebebeb] rounded-xl bg-white p-2 flex items-center justify-center max-h-40 overflow-hidden dark:border-neutral-700">
            <img id="sig-preview-img" src="" alt="Signature preview" class="max-w-full max-h-32 object-contain" />
          </div>
        </div>
      </div>

      <!-- Signer Label -->
      <div class="grid grid-cols-2 gap-3 pt-2 border-t border-[#ebebeb] dark:border-neutral-800">
        <div>
          <label class="block text-xs font-medium text-[#4d4d4d] mb-1 dark:text-neutral-400">Signer Name / Label</label>
          <input id="sig-signer-name" type="text" value="Authorised Signatory" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100" />
        </div>
      </div>
    </div>

    <!-- Modal Actions -->
    <div class="px-6 py-3.5 border-t border-[#ebebeb] bg-[#fafafa] flex items-center justify-between dark:border-neutral-800 dark:bg-neutral-900">
      <button id="btn-cancel-sig" type="button" class="px-4 py-2 text-xs font-medium text-[#4d4d4d] hover:text-[#171717] cursor-pointer dark:text-neutral-400 dark:hover:text-neutral-100">Cancel</button>
      <button id="btn-apply-sig" type="button" class="px-5 py-2 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-full shadow-sm cursor-pointer dark:bg-white dark:text-[#171717] dark:hover:bg-neutral-200">Apply Signature</button>
    </div>
  </div>
</div>
