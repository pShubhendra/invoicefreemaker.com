---
// CompanyManagerModal.astro - Manage Multiple Company Profiles
---

<div id="company-manager-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4 no-print">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-xl w-full overflow-hidden flex flex-col max-h-[85vh] animate-scale-in">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717]">My Companies / Profiles</h3>
          <p class="text-xs text-[#888888]">Switch between multiple businesses with 1 click</p>
        </div>
      </div>
      <button id="btn-close-company-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Action Bar -->
    <div class="p-4 border-b border-[#ebebeb] bg-white flex items-center justify-between gap-2">
      <span class="text-xs text-[#4d4d4d]">Select a profile to populate sender details & bank info</span>
      <button id="btn-save-current-as-company" type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors cursor-pointer shrink-0">
        + Save Current as Company
      </button>
    </div>

    <!-- Company Profiles List -->
    <div id="company-profiles-list" class="p-6 overflow-y-auto space-y-3 flex-1">
      <!-- Dynamically populated via JS -->
    </div>
  </div>
</div>
