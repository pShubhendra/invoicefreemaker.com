---
// CompanyManagerModal.astro - Multi-Business Profiles Manager
---

<div id="company-manager-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-xs p-4 no-print flex items-center justify-center">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-2xl w-full overflow-hidden flex flex-col max-h-[85vh] m-auto dark:bg-[#111] dark:border-neutral-800">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa] dark:border-neutral-800 dark:bg-neutral-900">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717] dark:text-neutral-100">My Companies / Business Profiles</h3>
          <p class="text-xs text-[#888888] dark:text-neutral-400">Save multiple company details and switch between them in 1 click</p>
        </div>
      </div>
      <button id="btn-close-company-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Actions bar -->
    <div class="px-6 py-3 border-b border-[#ebebeb] bg-white flex items-center justify-between gap-3 dark:border-neutral-800 dark:bg-[#111]">
      <span class="text-xs text-[#4d4d4d] dark:text-neutral-400">Select an existing business profile to autofill your invoice sender details.</span>
      <button id="btn-save-current-as-company" type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors shrink-0 cursor-pointer dark:bg-white dark:text-[#171717] dark:hover:bg-neutral-200">
        + Save Current as Company
      </button>
    </div>

    <!-- Company Profiles List -->
    <div id="company-profiles-list" class="p-6 overflow-y-auto space-y-3 flex-1">
      <!-- Dynamic list -->
    </div>
  </div>
</div>
