---
// Canvas.astro - Live WYSIWYG A4 Invoice Sheet with In-Place Editing
---

<div id="invoice-canvas-container" class="flex-1 flex justify-center overflow-x-auto p-2 sm:p-4 md:p-6 bg-[#fafafa]">
  <!-- A4 Printable Sheet -->
  <div
    id="invoice-paper"
    class="w-full max-w-[800px] min-h-[1050px] bg-white rounded-xl border border-[#ebebeb] shadow-level-3 p-8 sm:p-12 md:p-14 flex flex-col justify-between transition-all relative select-text"
  >
    <!-- TOP HEADER BAND -->
    <div class="space-y-8">
      <div class="flex flex-col sm:flex-row items-start justify-between gap-6">
        <!-- Sender Logo & Info -->
        <div class="space-y-4 max-w-sm">
          <!-- Logo Uploader Area -->
          <div class="relative group/logo inline-block">
            <div id="logo-display-wrap" class="w-36 h-16 border-2 border-dashed border-[#ebebeb] rounded-xl flex items-center justify-center bg-[#fafafa] group-hover/logo:border-[#171717] transition-all overflow-hidden cursor-pointer">
              <img id="sender-logo-img" src="" alt="Company Logo" class="w-full h-full object-contain p-1 hidden" />
              <div id="logo-placeholder" class="flex items-center gap-1.5 text-xs text-[#888888]">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                <span>Add Logo</span>
              </div>
            </div>
            <input id="logo-file-input" type="file" accept="image/*" class="hidden" />
            <button id="btn-remove-logo" type="button" class="hidden absolute -top-2 -right-2 w-5 h-5 rounded-full bg-red-600 text-white items-center justify-center text-xs shadow-xs hover:bg-red-700 cursor-pointer no-print">×</button>
          </div>

          <!-- Sender Details -->
          <div class="space-y-1">
            <div class="flex items-center justify-between gap-2">
              <div id="inv-sender-name" contenteditable="true" class="text-lg font-bold text-[#171717] outline-hidden leading-tight flex-1" placeholder="Your Business Name">
                Acme Design & Technology Inc.
              </div>
              <button id="btn-quick-switch-company" type="button" class="text-[11px] text-[#0070f3] hover:underline no-print cursor-pointer shrink-0 font-medium">
                My Companies
              </button>
            </div>
            <div id="inv-sender-address" contenteditable="true" class="text-xs text-[#4d4d4d] whitespace-pre-line outline-hidden leading-relaxed" placeholder="Business Address, City, Country">
              100 Innovation Way, Suite 400
              San Francisco, CA 94107
            </div>
            <div class="flex flex-wrap gap-x-3 text-xs text-[#4d4d4d] pt-0.5">
              <span id="inv-sender-email" contenteditable="true" class="outline-hidden" placeholder="billing@yourdomain.com">billing@acmedesign.io</span>
              <span class="text-[#ebebeb]">|</span>
              <span id="inv-sender-phone" contenteditable="true" class="outline-hidden" placeholder="+1 (555) 000-0000">+1 (555) 234-5678</span>
            </div>
            <div class="text-xs text-[#4d4d4d] flex items-center gap-1.5 pt-0.5">
              <span class="text-[#888888] font-mono text-[11px]">TAX / GST ID:</span>
              <span id="inv-sender-taxid" contenteditable="true" class="outline-hidden font-mono font-medium" placeholder="e.g. US-TAX-892341">US-TAX-892341</span>
            </div>
          </div>
        </div>

        <!-- Document Title & Invoice Meta Details -->
        <div class="text-left sm:text-right space-y-3 min-w-[240px]">
          <div>
            <div id="inv-doc-title" contenteditable="true" class="text-2xl sm:text-3xl font-bold tracking-tight text-[#171717] uppercase outline-hidden">
              TAX INVOICE
            </div>
            <div class="text-xs text-[#888888] font-mono mt-0.5 flex sm:justify-end items-center gap-1">
              <span>Invoice #:</span>
              <span id="inv-number" contenteditable="true" class="font-bold text-[#171717] outline-hidden">INV-2026-001</span>
            </div>
          </div>

          <!-- Metadata table (Dates, PO) -->
          <div class="bg-[#fafafa] p-3 rounded-xl border border-[#ebebeb] text-xs space-y-1.5">
            <div class="flex items-center justify-between gap-4">
              <span class="text-[#888888]">Invoice Date:</span>
              <input id="inv-issue-date" type="date" class="bg-transparent text-right font-medium text-[#171717] outline-hidden cursor-pointer" />
            </div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-[#888888]">Payment Due:</span>
              <input id="inv-due-date" type="date" class="bg-transparent text-right font-medium text-[#171717] outline-hidden cursor-pointer" />
            </div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[#888888] shrink-0">PO / Ref #:</span>
              <input id="inv-po-number" type="text" value="PO-2026-98" placeholder="e.g. PO-2026-98" class="bg-transparent text-right font-medium text-[#171717] outline-hidden border-b border-transparent focus:border-[#171717] w-full px-1" />
            </div>
          </div>
        </div>
      </div>

      <!-- CLIENT / BILL TO SECTION -->
      <div class="pt-4 border-t border-[#ebebeb] grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Bill To -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[#888888]">Billed To:</span>
            <button id="btn-quick-fill-client" type="button" class="text-[11px] text-[#0070f3] hover:underline no-print cursor-pointer font-medium">
              + Address Book
            </button>
          </div>
          <div id="inv-client-name" contenteditable="true" class="text-sm font-bold text-[#171717] outline-hidden leading-tight" placeholder="Client or Company Name">
            Globex Software Enterprises
          </div>
          <div id="inv-client-address" contenteditable="true" class="text-xs text-[#4d4d4d] whitespace-pre-line outline-hidden leading-relaxed" placeholder="Client Address, City, State, ZIP">
            742 Evergreen Terrace, Floor 3
            Springfield, OR 97477
          </div>
          <div class="flex flex-wrap gap-x-3 text-xs text-[#4d4d4d]">
            <span id="inv-client-email" contenteditable="true" class="outline-hidden" placeholder="client@email.com">accounts@globexcorp.com</span>
            <span class="text-[#ebebeb]">|</span>
            <span id="inv-client-phone" contenteditable="true" class="outline-hidden" placeholder="+1 (555) 000-0000">+1 (555) 987-6543</span>
          </div>
          <div class="text-xs text-[#4d4d4d] flex items-center gap-1.5">
            <span class="text-[#888888] font-mono text-[11px]">Client Tax ID:</span>
            <span id="inv-client-taxid" contenteditable="true" class="outline-hidden font-mono font-medium" placeholder="TAX / GST Number">TAX-552190</span>
          </div>
        </div>

        <!-- Optional Ship To / Custom Notes -->
        <div class="space-y-1.5 sm:border-l sm:border-[#ebebeb] sm:pl-6">
          <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[#888888]">Project / Notes:</span>
          <div id="inv-project-memo" contenteditable="true" class="text-xs text-[#4d4d4d] whitespace-pre-line outline-hidden leading-relaxed italic" placeholder="Add specific project reference or special delivery note...">
            Q1 Enterprise Platform Upgrade & Brand Revamp Milestone.
          </div>
        </div>
      </div>

      <!-- LINE ITEMS TABLE -->
      <div class="pt-2">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="inv-items-table">
            <thead>
              <tr class="border-y-2 border-[#171717] bg-[#fafafa] text-xs font-semibold text-[#171717]">
                <th class="py-2.5 px-3 w-10 text-center font-mono">#</th>
                <th class="py-2.5 px-3">Item Description</th>
                <th class="py-2.5 px-2 w-24 text-center font-mono col-hsn hidden">HSN/SAC</th>
                <th class="py-2.5 px-2 w-20 text-center col-unit hidden">Unit</th>
                <th class="py-2.5 px-3 w-20 text-right">Qty</th>
                <th class="py-2.5 px-3 w-28 text-right">Rate</th>
                <th class="py-2.5 px-2 w-20 text-right col-discount hidden">Disc %</th>
                <th class="py-2.5 px-3 w-28 text-right">Amount</th>
                <th class="py-2.5 px-2 w-8 no-print"></th>
              </tr>
            </thead>
            <tbody id="inv-items-body" class="divide-y divide-[#ebebeb] text-xs text-[#171717]">
              <!-- Populated dynamically via JS -->
            </tbody>
          </table>
        </div>

        <!-- Add Item & Catalog Buttons -->
        <div class="pt-3 flex items-center gap-2 no-print">
          <button
            id="btn-add-line-item"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#171717] bg-[#f5f5f5] hover:bg-[#ebebeb] rounded-lg transition-colors cursor-pointer border border-[#ebebeb]"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            <span>Add Line Item</span>
          </button>

          <button
            id="btn-open-item-catalog"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[#0070f3] bg-blue-50/60 hover:bg-blue-100 rounded-lg transition-colors cursor-pointer border border-blue-200"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            <span>+ From Items Catalog</span>
          </button>
        </div>
      </div>

      <!-- TOTALS & CALCULATION SUMMARY -->
      <div class="pt-4 border-t border-[#ebebeb] grid grid-cols-1 sm:grid-cols-2 gap-8 items-start">
        <!-- Left: Payment Details & Notes -->
        <div class="space-y-4 text-xs">
          <!-- Amount In Words -->
          <div class="p-3 bg-[#fafafa] rounded-xl border border-[#ebebeb] space-y-1">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#888888] font-semibold">Total in Words:</span>
            <div id="inv-amount-words" class="font-medium text-[#171717] capitalize text-xs">
              <!-- Calculated dynamically -->
            </div>
          </div>

          <!-- Bank & Wire Details -->
          <div class="p-3.5 bg-white rounded-xl border border-[#ebebeb] space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-[#171717]">Payment Details</span>
              <span class="text-[10px] text-[#888888]">Bank Transfer</span>
            </div>
            <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-xs text-[#4d4d4d]">
              <div><span class="text-[#888888] text-[10px] block">Bank Name</span><span id="bank-name" contenteditable="true" class="font-medium text-[#171717] outline-hidden">Silicon Valley Bank</span></div>
              <div><span class="text-[#888888] text-[10px] block">Account Name</span><span id="bank-holder" contenteditable="true" class="font-medium text-[#171717] outline-hidden">Acme Studio Inc</span></div>
              <div><span class="text-[#888888] text-[10px] block">Account / IBAN</span><span id="bank-account" contenteditable="true" class="font-mono text-[#171717] outline-hidden">987654321098</span></div>
              <div><span class="text-[#888888] text-[10px] block">IFSC / Routing / SWIFT</span><span id="bank-ifsc" contenteditable="true" class="font-mono text-[#171717] outline-hidden">SVBUS6S</span></div>
            </div>
          </div>

          <!-- Terms & Notes -->
          <div class="space-y-2">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#888888] font-semibold block mb-0.5">Terms & Conditions</span>
              <div id="inv-terms" contenteditable="true" class="text-xs text-[#4d4d4d] whitespace-pre-line outline-hidden leading-relaxed">
                1. Payment is due within 14 days of invoice date.
                2. Please mention the invoice number in your wire/transfer memo.
              </div>
            </div>
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#888888] font-semibold block mb-0.5">Client Note</span>
              <div id="inv-notes" contenteditable="true" class="text-xs text-[#4d4d4d] whitespace-pre-line outline-hidden leading-relaxed">
                Thank you for your business! We appreciate the opportunity to collaborate.
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Calculation Breakdown -->
        <div class="space-y-2 text-xs">
          <div class="bg-[#fafafa] p-4 rounded-xl border border-[#ebebeb] space-y-2.5">
            <!-- Subtotal -->
            <div class="flex items-center justify-between text-[#4d4d4d]">
              <span>Subtotal</span>
              <span id="sum-subtotal" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>

            <!-- Line Discounts (if any) -->
            <div id="sum-row-linedisc" class="hidden items-center justify-between text-emerald-700">
              <span>Item Discounts</span>
              <span id="sum-linedisc" class="font-mono font-medium">-$0.00</span>
            </div>

            <!-- Invoice Level Discount -->
            <div id="sum-row-invdisc" class="flex items-center justify-between text-emerald-700">
              <span id="sum-invdisc-label">Discount</span>
              <span id="sum-invdisc" class="font-mono font-medium">-$0.00</span>
            </div>

            <!-- Tax Rows -->
            <div id="sum-row-tax" class="flex items-center justify-between text-[#4d4d4d]">
              <span id="sum-tax-label">Tax (10%)</span>
              <span id="sum-tax" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>
            <div id="sum-row-cgst" class="hidden items-center justify-between text-[#4d4d4d]">
              <span id="sum-cgst-label">CGST (9%)</span>
              <span id="sum-cgst" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>
            <div id="sum-row-sgst" class="hidden items-center justify-between text-[#4d4d4d]">
              <span id="sum-sgst-label">SGST (9%)</span>
              <span id="sum-sgst" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>
            <div id="sum-row-igst" class="hidden items-center justify-between text-[#4d4d4d]">
              <span id="sum-igst-label">IGST (18%)</span>
              <span id="sum-igst" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>

            <!-- Shipping -->
            <div id="sum-row-shipping" class="hidden items-center justify-between text-[#4d4d4d]">
              <span>Shipping / Handling</span>
              <span id="sum-shipping" class="font-mono font-medium text-[#171717]">$0.00</span>
            </div>

            <!-- Round off -->
            <div id="sum-row-roundoff" class="flex items-center justify-between text-[#888888] text-[11px]">
              <span>Round Off</span>
              <span id="sum-roundoff" class="font-mono font-medium">$0.00</span>
            </div>

            <!-- Grand Total Highlight Band -->
            <div class="pt-3 border-t-2 border-[#171717] flex items-center justify-between text-base font-bold text-[#171717]">
              <span>Total Amount Due:</span>
              <span id="sum-grandtotal" class="font-mono text-lg text-[#171717]">$0.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTTOM SIGNATURE & PAYMENT QR CODE FOOTER -->
    <div class="pt-8 mt-8 border-t border-[#ebebeb] flex flex-col sm:flex-row items-end justify-between gap-6">
      <!-- Left: Payment QR Code Stamp -->
      <div id="inv-qr-section" class="flex items-center gap-3.5 p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
        <div class="w-20 h-20 bg-white rounded-lg border border-[#ebebeb] p-1 shadow-2xs flex items-center justify-center shrink-0">
          <img id="inv-qr-img" src="" alt="Payment QR" class="w-full h-full object-contain" />
        </div>
        <div class="space-y-0.5 text-left">
          <div class="text-[11px] font-bold text-[#171717] flex items-center gap-1">
            <span>Instant Scan to Pay</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          </div>
          <p id="inv-qr-desc" class="text-[10px] text-[#4d4d4d]">UPI / GPay / PhonePe / PayPal</p>
          <button id="btn-edit-qr-badge" type="button" class="text-[10px] text-[#0070f3] hover:underline no-print cursor-pointer">
            Edit QR Code
          </button>
        </div>
      </div>

      <!-- Right: Digital Signature Box -->
      <div id="inv-sig-section" class="text-right space-y-1 min-w-[200px]">
        <div class="relative inline-block text-center min-w-[180px]">
          <!-- Signature Visual Display -->
          <div id="sig-display-container" class="h-16 flex items-center justify-center border-b border-[#171717]">
            <img id="sig-display-img" src="" alt="Digital Signature" class="max-h-14 object-contain mx-auto hidden" />
            <span id="sig-display-text" class="text-2xl text-[#171717] font-['Caveat']">Alex Morgan</span>
          </div>
          <div class="pt-1.5 space-y-0.5">
            <div id="inv-sig-name" class="text-xs font-bold text-[#171717]">Alex Morgan</div>
            <div id="inv-sig-title" class="text-[10px] text-[#888888] uppercase font-mono tracking-wider">Authorized Signatory</div>
          </div>
          <button id="btn-edit-sig-badge" type="button" class="text-[10px] text-[#0070f3] hover:underline no-print block mt-1 cursor-pointer">
            Edit Signature
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
