---
// Canvas.astro - Multi-template invoice canvas (Corporate Pro, Minimal Light, Executive Split)
// The active template is cloned from a <template> tag into #invoice-paper by InvoiceEditor.
---

<div id="invoice-canvas-container" class="flex-1 overflow-x-auto p-2 sm:p-4">
  <div
    id="invoice-paper"
    class="w-full max-w-[820px] min-h-[1050px] bg-white rounded-xl border border-slate-200 shadow-level-3 mx-auto flex flex-col relative overflow-hidden"
    style="--inv-accent: #171717;"
  >
    <!-- Active template injected here by InvoiceEditor.applyTemplate() -->
  </div>
</div>

<!-- ============================================================ -->
<!-- TEMPLATE: CORPORATE PRO (gst_tally)                          -->
<!-- ============================================================ -->
<template id="tmpl-gst_tally">
  <div class="flex flex-col flex-1">

    <div id="inv-header-band" class="relative px-8 py-7" style="background-color: var(--inv-accent);">
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 85% 15%, #ffffff 0%, transparent 45%);"></div>

      <div class="relative flex items-start justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="relative group/logo">
            <div id="logo-display-wrap" class="w-14 h-14 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden cursor-pointer hover:shadow-md transition-shadow">
              <img id="sender-logo-img" src="" alt="Company logo" class="w-full h-full object-contain p-1 hidden" />
              <div id="logo-placeholder" class="text-slate-400 hidden">
                <svg class="w-9 h-9 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zM18.75 12.75v3.375A1.875 1.875 0 0116.875 18H5.625A1.875 1.875 0 013.75 16.125V5.625A1.875 1.875 0 015.625 3.75H9" /></svg>
              </div>
            </div>
            <input id="logo-file-input" type="file" accept="image/*" class="hidden" />
            <button id="btn-remove-logo" type="button" title="Remove logo" class="hidden absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-red-500 text-white text-[11px] flex items-center justify-center no-print cursor-pointer shadow-sm z-10">×</button>
          </div>

          <div>
            <div class="flex items-center gap-2">
              <div id="inv-sender-name" contenteditable="true" class="text-white font-bold text-lg tracking-tight outline-none leading-tight" style="min-width: 120px;">Surabhi Hardwares</div>
              <button id="btn-quick-switch-company" type="button" class="text-white/70 text-[10px] hover:text-white no-print cursor-pointer border border-white/30 rounded px-1.5 py-0.5 transition-colors">Switch</button>
            </div>
            <div id="inv-sender-address" contenteditable="true" class="text-white/80 text-xs whitespace-pre-line outline-none mt-1 leading-relaxed">HSR Layout, Bangalore - 560102</div>
            <div class="flex items-center gap-3 mt-1.5 text-white/70 text-[11px]">
              <span id="inv-sender-email" contenteditable="true" class="outline-none">billing@surabhihardwares.com</span>
              <span class="opacity-40">·</span>
              <span id="inv-sender-phone" contenteditable="true" class="outline-none">+91 98765 43210</span>
            </div>
            <div class="text-white/70 text-[11px] mt-1 font-mono">
              GST: <span id="inv-sender-taxid" contenteditable="true" class="outline-none font-bold text-white/90">29AACCT3705E000</span>
            </div>
          </div>
        </div>

        <div class="text-right shrink-0">
          <div id="inv-doc-title" contenteditable="true" class="text-white text-3xl font-bold tracking-wide uppercase outline-none leading-none">TAX INVOICE</div>
          <div class="flex items-center justify-end gap-1.5 mt-2 text-white/70 text-xs font-mono">
            <span>#</span>
            <span id="inv-number" contenteditable="true" class="text-white font-bold outline-none">SHB/456/20</span>
          </div>

          <div class="mt-3 inline-flex flex-col items-end gap-1.5 bg-white/10 border border-white/20 rounded-lg px-3.5 py-2.5 text-[11px]">
            <div class="flex items-center justify-end gap-2 text-white/85">
              <span class="font-medium uppercase tracking-wider text-[9px]">Date</span>
              <input id="inv-issue-date" type="date" class="bg-white/20 text-white border border-white/30 rounded px-1.5 py-0.5 text-[11px] outline-none cursor-pointer" />
            </div>
            <div class="flex items-center justify-end gap-2 text-white/85">
              <span class="font-medium uppercase tracking-wider text-[9px]">Due</span>
              <input id="inv-due-date" type="date" class="bg-white/20 text-white border border-white/30 rounded px-1.5 py-0.5 text-[11px] outline-none cursor-pointer" />
            </div>
            <div class="flex items-center justify-end gap-2 text-white/85">
              <span class="font-medium uppercase tracking-wider text-[9px]">PO / Ref</span>
              <input id="inv-po-number" type="text" value="" placeholder="PO number" class="bg-white/20 text-white border border-white/30 rounded px-1.5 py-0.5 text-[11px] outline-none w-28" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="px-8 py-6 flex-1 space-y-6">
      <div class="grid grid-cols-2 gap-6">
        <div class="space-y-1">
          <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5" style="color: var(--inv-accent);">Billed To:</div>
          <div class="flex items-center gap-2">
            <div id="inv-client-name" contenteditable="true" class="font-bold text-sm text-slate-900 outline-none leading-tight flex-1">Kiran Enterprises</div>
            <button id="btn-quick-fill-client" type="button" class="text-[10px] text-[#0070f3] hover:underline no-print cursor-pointer">+ Book</button>
          </div>
          <div id="inv-client-address" contenteditable="true" class="text-xs text-slate-600 whitespace-pre-line outline-none leading-relaxed">12th Cross, Indiranagar
Bangalore - 560038</div>
          <div class="flex gap-3 text-xs text-slate-600">
            <span id="inv-client-email" contenteditable="true" class="outline-none">accounts@kiran.com</span>
          </div>
          <div class="text-xs font-mono text-slate-500">
            GST: <span id="inv-client-taxid" contenteditable="true" class="outline-none font-bold text-slate-800">29AAFFC8126N1ZZ</span>
          </div>
        </div>

        <div class="space-y-1 border-l border-slate-200 pl-6">
          <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5 text-slate-500">Notes / Project</div>
          <div id="inv-notes" contenteditable="true" class="text-xs text-slate-600 outline-none italic whitespace-pre-line">Q1 Deliverables & Materials milestone.</div>
        </div>
      </div>

      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left border-collapse text-xs" id="inv-items-table">
          <thead>
            <tr id="inv-table-header" class="text-white text-[10px] font-semibold uppercase tracking-wider" style="background-color: var(--inv-accent);">
              <th class="py-3 px-3 w-8 text-center">#</th>
              <th class="py-3 px-3">Item Description</th>
              <th class="py-3 px-2 w-20 text-center col-hsn">HSN/SAC</th>
              <th class="py-3 px-2 w-16 text-center col-unit">Unit</th>
              <th class="py-3 px-3 w-16 text-right">Qty</th>
              <th class="py-3 px-3 w-24 text-right" id="inv-rate-header">Rate (₹)</th>
              <th class="py-3 px-2 w-16 text-right col-discount">Disc%</th>
              <th class="py-3 px-3 w-24 text-right">Amount</th>
              <th class="py-3 px-2 w-8 no-print"></th>
            </tr>
          </thead>
          <tbody id="inv-items-body" class="divide-y divide-slate-100 text-slate-800"></tbody>
        </table>
      </div>

      <div class="flex items-center gap-2 no-print">
        <button id="btn-add-line-item" type="button" class="px-3 py-1.5 text-xs font-medium text-white rounded-lg cursor-pointer transition-opacity hover:opacity-80" style="background-color: var(--inv-accent);">+ Add Line Item</button>
        <button id="btn-open-item-catalog" type="button" class="px-3 py-1.5 text-xs font-medium text-[#0070f3] bg-[#fafafa] hover:bg-[#ebebeb] rounded-lg border border-[#ebebeb] cursor-pointer">+ From Catalog</button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t-2 border-slate-200">
        <div class="space-y-4">
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200">
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Amount in Words</div>
            <div id="inv-amount-words" class="text-xs font-medium text-slate-700 capitalize leading-relaxed"></div>
          </div>

          <div class="rounded-xl border border-slate-200 divide-y divide-slate-100">
            <div class="px-3.5 py-2 text-[10px] uppercase font-bold tracking-wider text-slate-500">Bank / Payment Details</div>
            <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 px-3.5 py-2.5 text-xs">
              <div><span class="text-[9px] text-slate-400 uppercase block tracking-wider">Bank</span><span id="bank-name" contenteditable="true" class="font-medium text-slate-800 outline-none">HDFC Bank</span></div>
              <div><span class="text-[9px] text-slate-400 uppercase block tracking-wider">A/C Name</span><span id="bank-holder" contenteditable="true" class="font-medium text-slate-800 outline-none">Surabhi Hardwares</span></div>
              <div><span class="text-[9px] text-slate-400 uppercase block tracking-wider">Account No.</span><span id="bank-account" contenteditable="true" class="font-mono text-slate-800 outline-none">50200012345678</span></div>
              <div><span class="text-[9px] text-slate-400 uppercase block tracking-wider">IFSC</span><span id="bank-ifsc" contenteditable="true" class="font-mono text-slate-800 outline-none">HDFCINBB</span></div>
            </div>
          </div>

          <div>
            <div class="text-[10px] uppercase font-bold tracking-wider text-slate-500 mb-1">Terms & Conditions</div>
            <div id="inv-terms" contenteditable="true" class="text-[11px] text-slate-600 outline-none leading-relaxed">1. Goods once sold will not be taken back.
2. Interest @ 18% p.a. will be charged if payment is not made within due date.</div>
          </div>
        </div>

        <div class="space-y-2 text-xs">
          <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2.5">
            <div class="flex items-center justify-between text-slate-600">
              <span>Subtotal</span>
              <span id="sum-subtotal" class="font-mono font-medium text-slate-800">₹0.00</span>
            </div>
            <div id="sum-row-invdisc" class="hidden items-center justify-between text-emerald-700">
              <span id="sum-invdisc-label">Discount</span>
              <span id="sum-invdisc" class="font-mono font-medium"></span>
            </div>
            <div id="sum-row-tax" class="flex items-center justify-between text-slate-600">
              <span id="sum-tax-label">Tax (18%)</span>
              <span id="sum-tax" class="font-mono font-medium text-slate-800">₹0.00</span>
            </div>
            <div id="sum-row-cgst" class="flex items-center justify-between text-slate-600">
              <span id="sum-cgst-label">CGST (9%)</span>
              <span id="sum-cgst" class="font-mono font-medium text-slate-800">₹0.00</span>
            </div>
            <div id="sum-row-sgst" class="flex items-center justify-between text-slate-600">
              <span id="sum-sgst-label">SGST (9%)</span>
              <span id="sum-sgst" class="font-mono font-medium text-slate-800">₹0.00</span>
            </div>
            <div id="sum-row-igst" class="hidden items-center justify-between text-slate-600">
              <span id="sum-igst-label">IGST (18%)</span>
              <span id="sum-igst" class="font-mono font-medium text-slate-800">₹0.00</span>
            </div>
            <div id="sum-row-shipping" class="hidden items-center justify-between text-slate-600">
              <span>Shipping</span>
              <span id="sum-shipping" class="font-mono font-medium text-slate-800"></span>
            </div>
          </div>

          <div class="rounded-xl px-4 py-3 flex items-center justify-between text-white shadow-sm" style="background-color: var(--inv-accent);">
            <span class="font-semibold text-sm tracking-tight">Total Due</span>
            <span id="sum-grandtotal" class="font-mono text-lg font-bold">₹0.00</span>
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-200 flex items-end justify-between gap-6">
        <div id="inv-qr-section" class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-20 h-20 bg-white rounded-lg border border-slate-200 p-1 flex items-center justify-center shrink-0">
            <img id="inv-qr-img" src="" alt="Payment QR" class="w-full h-full object-contain" />
          </div>
          <div class="text-left">
            <div class="text-[11px] font-bold text-slate-800">Scan to Pay</div>
            <p id="inv-qr-desc" class="text-[10px] text-slate-500">UPI / GPay / PhonePe</p>
          </div>
        </div>

        <div id="inv-sig-section" class="text-right space-y-1 min-w-[180px]">
          <div class="h-14 flex items-center justify-center border-b-2 mb-1" style="border-color: var(--inv-accent);">
            <img id="sig-display-img" src="" alt="Signature" class="max-h-12 object-contain hidden" />
            <span id="sig-display-text" class="text-2xl text-slate-800" style="font-family: 'Caveat', cursive;">Authorised Signatory</span>
          </div>
          <div id="inv-sig-name" class="text-xs font-bold text-slate-800">Authorised Signatory</div>
          <div id="inv-sig-title" class="text-[10px] text-slate-500">for Surabhi Hardwares</div>
        </div>
      </div>

      <div class="text-center text-[10px] text-slate-400 pt-2 border-t border-slate-100">
        This is a Computer Generated Invoice · invoicefreemaker.com
      </div>
    </div>
  </div>
</template>

<!-- ============================================================ -->
