---
// PaymentQrModal.astro - Dynamic QR Code Generator Studio
---

<div id="payment-qr-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-xs p-4 no-print flex items-center justify-center">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-xl w-full overflow-hidden flex flex-col max-h-[85vh] m-auto animate-scale-in">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717]">Payment QR Code Studio</h3>
          <p class="text-xs text-[#888888]">Enable instant scan-to-pay on your invoice with dynamic amount</p>
        </div>
      </div>
      <button id="btn-close-qr-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="px-6 pt-4 pb-2 bg-white">
      <div class="flex items-center p-1 rounded-xl bg-[#f5f5f5] text-xs font-medium">
        <button id="qr-tab-upi" type="button" class="flex-1 py-1.5 rounded-lg bg-white text-[#171717] shadow-xs transition-all cursor-pointer text-center">
          India UPI
        </button>
        <button id="qr-tab-paypal" type="button" class="flex-1 py-1.5 rounded-lg text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer text-center">
          PayPal
        </button>
        <button id="qr-tab-custom" type="button" class="flex-1 py-1.5 rounded-lg text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer text-center">
          Custom Link
        </button>
      </div>
    </div>

    <!-- Tab Contents & Live Preview -->
    <div class="p-6 space-y-4 flex-1 overflow-y-auto">
      <div class="flex flex-col sm:flex-row gap-6 items-center">
        <!-- Live QR Preview Card -->
        <div class="shrink-0 w-36 h-36 bg-[#fafafa] border border-[#ebebeb] rounded-xl p-2 flex flex-col items-center justify-center shadow-xs">
          <img id="qr-preview-img" src="" alt="QR Preview" class="w-full h-full object-contain" />
        </div>

        <!-- Form fields -->
        <div class="flex-1 space-y-3 w-full">
          <!-- UPI Form -->
          <div id="qr-content-upi" class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-[#4d4d4d] mb-1">UPI ID / VPA (e.g. yourname@oksbi / merchant@upi)</label>
              <input id="qr-upi-id" type="text" value="surabhihardwares@okhdfcbank" placeholder="name@upi" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717]" />
            </div>
            <div>
              <label class="block text-xs font-medium text-[#4d4d4d] mb-1">Payee Name</label>
              <input id="qr-upi-name" type="text" value="Surabhi Hardwares" placeholder="Business or personal name" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717]" />
            </div>
          </div>

          <!-- PayPal Form -->
          <div id="qr-content-paypal" class="hidden space-y-3">
            <div>
              <label class="block text-xs font-medium text-[#4d4d4d] mb-1">PayPal.me URL or Username</label>
              <input id="qr-paypal-url" type="text" placeholder="https://paypal.me/yourname" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717]" />
            </div>
          </div>

          <!-- Custom Link Form -->
          <div id="qr-content-custom" class="hidden space-y-3">
            <div>
              <label class="block text-xs font-medium text-[#4d4d4d] mb-1">Payment Web Link (Stripe, Razorpay, Crypto, etc.)</label>
              <input id="qr-custom-url" type="url" placeholder="https://buy.stripe.com/..." class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717]" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Actions -->
    <div class="px-6 py-3.5 border-t border-[#ebebeb] bg-[#fafafa] flex items-center justify-between">
      <button id="btn-cancel-qr" type="button" class="px-4 py-2 text-xs font-medium text-[#4d4d4d] hover:text-[#171717] cursor-pointer">Cancel</button>
      <button id="btn-apply-qr" type="button" class="px-5 py-2 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-full shadow-sm cursor-pointer">Apply QR Code</button>
    </div>
  </div>
</div>
