---
// SidebarControls.astro - Control Panel for Invoice Settings & Export
import { DOCUMENT_TYPES, ACCENT_COLORS, CURRENCIES, THEME_PRESETS } from '../../scripts/invoice-state.js';
---

<aside class="w-full lg:w-80 shrink-0 space-y-4 no-print">
  <!-- Main Export Card (Sticky on Desktop) -->
  <div class="bg-white rounded-2xl border border-[#ebebeb] p-5 shadow-level-2 space-y-4">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#888888] font-mono">Actions</span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Auto-Saved
      </span>
    </div>

    <!-- Primary Download Button -->
    <button
      id="btn-download-pdf"
      type="button"
      class="w-full py-3 px-4 rounded-xl bg-[#171717] hover:bg-black text-white text-sm font-medium shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 active:scale-98 cursor-pointer group"
    >
      <svg class="w-4 h-4 transition-transform group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      <span>Download PDF</span>
    </button>

    <!-- Secondary Quick Share Actions -->
    <div class="grid grid-cols-2 gap-2">
      <button
        id="btn-print-invoice"
        type="button"
        class="py-2 px-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-white text-xs font-medium text-[#171717] transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>Print</span>
      </button>

      <button
        id="btn-download-png"
        type="button"
        class="py-2 px-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-white text-xs font-medium text-[#171717] transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Export PNG</span>
      </button>

      <button
        id="btn-share-whatsapp"
        type="button"
        class="py-2 px-3 rounded-lg border border-emerald-200 bg-emerald-50/60 hover:bg-emerald-100 text-xs font-medium text-emerald-800 transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>WhatsApp</span>
      </button>

      <button
        id="btn-share-email"
        type="button"
        class="py-2 px-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-white text-xs font-medium text-[#171717] transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
      >
        <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Email</span>
      </button>
    </div>

    <!-- Clear / Reset / New Invoice -->
    <div class="pt-2 border-t border-[#ebebeb] flex items-center justify-between text-xs">
      <button id="btn-new-invoice" type="button" class="text-[#0070f3] hover:underline font-medium cursor-pointer">
        + New Blank Invoice
      </button>
      <button id="btn-reset-sample" type="button" class="text-[#888888] hover:text-[#171717] cursor-pointer">
        Load Sample Data
      </button>
    </div>
  </div>

  <!-- Design & Document Customizer Card -->
  <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-level-2 space-y-4">
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 font-mono">Design & Format</span>

    <!-- Template Style -->
    <div>
      <label class="block text-xs font-medium text-slate-500 mb-1.5">Template Style</label>
      <select id="ctrl-template" class="w-full px-3 py-2 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717] font-medium">
        {THEME_PRESETS.map(t => (
          <option value={t.id}>{t.name}</option>
        ))}
      </select>
    </div>

    <!-- Document Type -->
    <div>
      <label class="block text-xs font-medium text-[#4d4d4d] mb-1.5">Document Type</label>
      <select id="ctrl-doc-type" class="w-full px-3 py-2 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717] font-medium">
        {DOCUMENT_TYPES.map(t => (
          <option value={t.id}>{t.label}</option>
        ))}
      </select>
    </div>

    <!-- Accent Color Palette -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label class="block text-xs font-medium text-[#4d4d4d]">Corporate Accent Color</label>
        <span id="ctrl-active-color-name" class="text-[10px] font-mono text-[#888888]">#171717</span>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        {ACCENT_COLORS.map((col, i) => (
          <button
            type="button"
            data-color={col}
            class={`ctrl-color-btn w-6 h-6 rounded-full transition-all cursor-pointer ${i === 0 ? 'ring-2 ring-offset-2 ring-[#171717] scale-110' : 'hover:scale-105'}`}
            style={`background-color: ${col};`}
            title={col}
          ></button>
        ))}
        <label
          class="w-6 h-6 rounded-full border border-dashed border-[#888888] overflow-hidden cursor-pointer hover:scale-105 transition-all"
          title="Pick any color"
        >
          <input id="ctrl-accent-picker" type="color" value="#171717" class="w-8 h-8 -m-1 cursor-pointer border-0 p-0 bg-transparent" />
        </label>
      </div>
    </div>

    <!-- Currency Selector -->
    <div>
      <label class="block text-xs font-medium text-[#4d4d4d] mb-1.5">Currency</label>
      <select id="ctrl-currency" class="w-full px-3 py-2 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717]">
        {CURRENCIES.map(c => (
          <option value={c.code}>{c.symbol} - {c.name}</option>
        ))}
      </select>
    </div>
  </div>

  <!-- Smart Tax & Calculation Rules -->
  <div class="bg-white rounded-2xl border border-[#ebebeb] p-5 shadow-level-2 space-y-4">
    <span class="text-xs font-semibold uppercase tracking-wider text-[#888888] font-mono">Tax & Calculations</span>

    <!-- Tax Mode Selector -->
    <div>
      <label class="block text-xs font-medium text-[#4d4d4d] mb-1.5">Tax Calculation Mode</label>
      <select id="ctrl-tax-mode" class="w-full px-3 py-2 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717]">
        <option value="gst" selected>India GST (CGST + SGST / IGST)</option>
        <option value="single">Single Tax / VAT / Sales Tax (%)</option>
        <option value="none">No Tax (Tax Exempt)</option>
      </select>
    </div>

    <!-- Single Tax Rate Input -->
    <div id="ctrl-single-tax-wrap" class="hidden space-y-1">
      <div class="flex items-center justify-between text-xs text-[#4d4d4d]">
        <span>Tax Rate (%)</span>
        <span id="ctrl-tax-rate-display" class="font-mono font-medium">18%</span>
      </div>
      <input id="ctrl-tax-rate" type="number" step="0.1" min="0" max="100" value="18" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717]" />
    </div>

    <!-- GST Controls Wrap -->
    <div id="ctrl-gst-wrap" class="space-y-2 pt-1 border-t border-[#ebebeb]">
      <label class="flex items-center gap-2 text-xs text-[#171717] cursor-pointer">
        <input id="ctrl-gst-interstate" type="checkbox" class="rounded border-[#ebebeb] text-[#171717] focus:ring-0" />
        <span>Interstate Transaction (IGST)</span>
      </label>
      <div id="ctrl-intra-rates" class="grid grid-cols-2 gap-2 text-xs">
        <div>
          <span class="text-[#888888] block text-[10px] mb-0.5">CGST (%)</span>
          <input id="ctrl-cgst-rate" type="number" step="0.5" value="9" class="w-full px-2.5 py-1 text-xs rounded-lg border border-[#ebebeb]" />
        </div>
        <div>
          <span class="text-[#888888] block text-[10px] mb-0.5">SGST (%)</span>
          <input id="ctrl-sgst-rate" type="number" step="0.5" value="9" class="w-full px-2.5 py-1 text-xs rounded-lg border border-[#ebebeb]" />
        </div>
      </div>
      <div id="ctrl-inter-rate" class="hidden text-xs">
        <span class="text-[#888888] block text-[10px] mb-0.5">IGST Rate (%)</span>
        <input id="ctrl-igst-rate" type="number" step="0.5" value="18" class="w-full px-2.5 py-1 text-xs rounded-lg border border-[#ebebeb]" />
      </div>
    </div>

    <!-- Discount & Shipping Settings -->
    <div class="space-y-2 pt-2 border-t border-[#ebebeb]">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs font-medium text-[#4d4d4d]">Invoice Discount</label>
        <div class="flex items-center gap-1">
          <input id="ctrl-discount-val" type="number" min="0" value="0" class="w-16 px-2 py-1 text-xs rounded-lg border border-[#ebebeb] text-right font-mono" />
          <select id="ctrl-discount-type" class="px-1.5 py-1 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa]">
            <option value="percent">%</option>
            <option value="fixed">Flat</option>
          </select>
        </div>
      </div>

      <div class="flex items-center justify-between gap-2">
        <label class="text-xs font-medium text-[#4d4d4d]">Shipping / Delivery Fee</label>
        <input id="ctrl-shipping-val" type="number" min="0" value="0" class="w-24 px-2 py-1 text-xs rounded-lg border border-[#ebebeb] text-right font-mono" />
      </div>

      <label class="flex items-center gap-2 text-xs text-[#4d4d4d] cursor-pointer pt-1">
        <input id="ctrl-roundoff-toggle" type="checkbox" checked class="rounded border-[#ebebeb] text-[#171717] focus:ring-0" />
        <span>Auto round-off grand total</span>
      </label>
    </div>
  </div>

  <!-- Custom Columns & Features Toggle (Fully Functional) -->
  <div class="bg-white rounded-2xl border border-[#ebebeb] p-5 shadow-level-2 space-y-3">
    <span class="text-xs font-semibold uppercase tracking-wider text-[#888888] font-mono">Columns & Extra Fields</span>
    <div class="space-y-2 text-xs">
      <label class="flex items-center justify-between text-[#4d4d4d] cursor-pointer hover:text-[#171717]">
        <span>HSN / SAC Code Column</span>
        <input id="ctrl-col-hsn" type="checkbox" checked class="rounded border-[#ebebeb] text-[#171717] focus:ring-0 cursor-pointer" />
      </label>
      <label class="flex items-center justify-between text-[#4d4d4d] cursor-pointer hover:text-[#171717]">
        <span>Unit Column (e.g. No, Hours)</span>
        <input id="ctrl-col-unit" type="checkbox" checked class="rounded border-[#ebebeb] text-[#171717] focus:ring-0 cursor-pointer" />
      </label>
      <label class="flex items-center justify-between text-[#4d4d4d] cursor-pointer hover:text-[#171717]">
        <span>Item-Level Discount Column</span>
        <input id="ctrl-col-discount" type="checkbox" checked class="rounded border-[#ebebeb] text-[#171717] focus:ring-0 cursor-pointer" />
      </label>
    </div>

    <!-- Quick Studio Launchers -->
    <div class="pt-3 border-t border-[#ebebeb] space-y-2">
      <button
        id="btn-sidebar-open-companies"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-[#fafafa] hover:bg-[#ebebeb] text-xs font-medium text-[#171717] border border-[#ebebeb] transition-all flex items-center justify-between cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          My Companies / Profiles
        </span>
        <span class="text-[10px] font-mono text-[#888888]">Manage</span>
      </button>

      <button
        id="btn-sidebar-open-catalog"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-[#fafafa] hover:bg-[#ebebeb] text-xs font-medium text-[#171717] border border-[#ebebeb] transition-all flex items-center justify-between cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          Items Catalog
        </span>
        <span class="text-[10px] font-mono text-[#888888]">Saved</span>
      </button>

      <button
        id="btn-sidebar-open-clients"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-[#fafafa] hover:bg-[#ebebeb] text-xs font-medium text-[#171717] border border-[#ebebeb] transition-all flex items-center justify-between cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          Client Address Book
        </span>
        <span class="text-[10px] font-mono text-[#888888]">Saved</span>
      </button>

      <button
        id="btn-sidebar-open-sig"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-[#fafafa] hover:bg-[#ebebeb] text-xs font-medium text-[#171717] border border-[#ebebeb] transition-all flex items-center justify-between cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
          Signature Studio
        </span>
        <span class="text-[10px] font-mono text-[#888888]" id="sig-status-badge">Active</span>
      </button>

      <button
        id="btn-sidebar-open-qr"
        type="button"
        class="w-full py-2 px-3 rounded-lg bg-[#fafafa] hover:bg-[#ebebeb] text-xs font-medium text-[#171717] border border-[#ebebeb] transition-all flex items-center justify-between cursor-pointer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-[#4d4d4d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
          Payment QR Code
        </span>
        <span class="text-[10px] font-mono text-[#888888]" id="qr-status-badge">Active</span>
      </button>
    </div>
  </div>
</aside>
