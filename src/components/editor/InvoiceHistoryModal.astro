---
// InvoiceHistoryModal.astro - Local Storage Invoicing Vault
---

<div id="invoice-history-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-xs p-4 no-print flex items-center justify-center">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-2xl w-full overflow-hidden flex flex-col max-h-[85vh] m-auto dark:bg-[#111] dark:border-neutral-800">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa] dark:border-neutral-800 dark:bg-neutral-900">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717] dark:text-neutral-100">Invoices Vault (Local Storage)</h3>
          <p class="text-xs text-[#888888] dark:text-neutral-400">100% private to your browser · No cloud tracking</p>
        </div>
      </div>
      <button id="btn-close-history-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Search & Filter Bar -->
    <div class="px-6 py-3 border-b border-[#ebebeb] bg-white flex flex-wrap items-center justify-between gap-3 dark:border-neutral-800 dark:bg-[#111]">
      <div class="relative flex-1 min-w-[200px]">
        <svg class="w-4 h-4 absolute left-3 top-2.5 text-[#888888] dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="history-search-input"
          type="text"
          placeholder="Search by client or invoice #..."
          class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[#171717] focus:outline-hidden focus:border-[#171717] dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:focus:border-neutral-400"
        />
      </div>

      <div class="flex items-center gap-2">
        <button id="btn-export-backup-json" type="button" class="px-3 py-1.5 text-xs font-medium text-[#4d4d4d] hover:text-[#171717] bg-[#f5f5f5] rounded-lg border border-[#ebebeb] hover:bg-[#ebebeb] transition-colors cursor-pointer dark:text-neutral-300 dark:hover:text-white dark:bg-neutral-800 dark:border-neutral-700 dark:hover:bg-neutral-700" title="Export all invoices as JSON backup">
          Backup JSON
        </button>
        <label class="px-3 py-1.5 text-xs font-medium text-[#4d4d4d] hover:text-[#171717] bg-[#f5f5f5] rounded-lg border border-[#ebebeb] hover:bg-[#ebebeb] transition-colors cursor-pointer dark:text-neutral-300 dark:hover:text-white dark:bg-neutral-800 dark:border-neutral-700 dark:hover:bg-neutral-700" title="Import JSON backup">
          Import
          <input id="input-import-backup-json" type="file" accept=".json" class="hidden" />
        </label>
      </div>
    </div>

    <!-- List of Invoices -->
    <div id="history-items-container" class="p-6 overflow-y-auto space-y-3 flex-1">
      <!-- Dynamic list or empty state -->
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-3 border-t border-[#ebebeb] bg-[#fafafa] flex items-center justify-between text-xs text-[#888888] dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-500">
      <span id="history-total-summary">0 Invoices stored</span>
      <button id="btn-save-current-to-vault" type="button" class="px-4 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-full shadow-xs transition-all cursor-pointer dark:bg-white dark:text-[#171717] dark:hover:bg-neutral-200">
        Save Current Invoice to Vault
      </button>
    </div>
  </div>
</div>
