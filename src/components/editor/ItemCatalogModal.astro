---
// ItemCatalogModal.astro - Products & Services Catalog
---

<div id="item-catalog-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-xs p-4 no-print flex items-center justify-center">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-2xl w-full overflow-hidden flex flex-col max-h-[85vh] m-auto">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717]">Items & Services Catalog</h3>
          <p class="text-xs text-[#888888]">Save reusable products and line items to insert into invoices in 1 click</p>
        </div>
      </div>
      <button id="btn-close-item-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Add Item Form -->
    <div class="p-4 border-b border-[#ebebeb] bg-[#fafafa] space-y-2">
      <span class="text-xs font-semibold text-[#171717] uppercase tracking-wider block">Add New Catalog Item</span>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
        <input id="catalog-desc-input" type="text" placeholder="Item / Service description *" class="sm:col-span-2 px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white" />
        <input id="catalog-hsn-input" type="text" placeholder="HSN/SAC" class="px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white" />
        <div class="flex items-center gap-1.5">
          <input id="catalog-rate-input" type="number" placeholder="Rate *" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white" />
          <button id="btn-save-new-catalog-item" type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors shrink-0 cursor-pointer">
            Save
          </button>
        </div>
      </div>
    </div>

    <!-- Catalog List -->
    <div id="catalog-items-list" class="p-6 overflow-y-auto space-y-2 flex-1">
      <!-- Dynamic list -->
    </div>
  </div>
</div>
