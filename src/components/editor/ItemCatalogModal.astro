---
// ItemCatalogModal.astro - Manage Products & Services Catalog
---

<div id="item-catalog-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4 no-print">
  <div class="bg-white rounded-2xl border border-[#ebebeb] shadow-level-5 max-w-xl w-full overflow-hidden flex flex-col max-h-[85vh] animate-scale-in">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between bg-[#fafafa]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-[#171717] text-white flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#171717]">Items & Services Catalog</h3>
          <p class="text-xs text-[#888888]">1-Click add saved services/products to invoice</p>
        </div>
      </div>
      <button id="btn-close-item-modal" type="button" class="text-[#888888] hover:text-[#171717] p-1.5 rounded-lg hover:bg-[#ebebeb] transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <!-- Add Item Form Accordion -->
    <div class="p-4 border-b border-[#ebebeb] bg-[#fafafa]">
      <details id="details-add-item" class="group">
        <summary class="flex items-center justify-between text-xs font-semibold text-[#171717] cursor-pointer select-none">
          <span>+ Add New Product / Service to Catalog</span>
          <span class="text-[#888888] group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pt-3 space-y-2">
          <div>
            <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Item / Service Description</label>
            <input id="catalog-desc-input" type="text" placeholder="e.g. Website Maintenance & Support" class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white text-[#171717] focus:outline-hidden focus:border-[#171717]" />
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">HSN / SAC</label>
              <input id="catalog-hsn-input" type="text" placeholder="998314" class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white text-[#171717]" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Unit</label>
              <input id="catalog-unit-input" type="text" placeholder="Hours" class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white text-[#171717]" />
            </div>
            <div>
              <label class="block text-[11px] font-medium text-[#4d4d4d] mb-0.5">Default Rate</label>
              <input id="catalog-rate-input" type="number" step="any" placeholder="100" class="w-full px-2.5 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-white text-[#171717] font-mono" />
            </div>
          </div>
          <div class="flex justify-end pt-1">
            <button id="btn-save-new-catalog-item" type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-colors cursor-pointer">
              Save Item
            </button>
          </div>
        </div>
      </details>
    </div>

    <!-- Items List -->
    <div id="catalog-items-list" class="p-6 overflow-y-auto space-y-2.5 flex-1">
      <!-- Populated via JS -->
    </div>
  </div>
</div>
