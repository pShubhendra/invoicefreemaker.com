  // Apply Theme & Accent Color Styling to Sheet
  function applyThemeStyling() {
    if (!paper) return;
    const theme = invoice.theme || 'minimal';
    const accent = invoice.accentColor || '#171717';

    paper.style.setProperty('--inv-accent', accent);

    const docTitle = document.getElementById('inv-doc-title');
    if (docTitle) {
      docTitle.style.color = accent;
    }

    const tableHeader = document.querySelector('#inv-items-table thead tr') as HTMLElement;
    if (tableHeader) {
      if (theme === 'executive') {
        tableHeader.style.backgroundColor = accent;
        tableHeader.style.color = '#ffffff';
        tableHeader.style.borderColor = accent;
      } else if (theme === 'contrast') {
        tableHeader.style.backgroundColor = '#171717';
        tableHeader.style.color = '#ffffff';
        tableHeader.style.borderColor = '#171717';
      } else {
        tableHeader.style.backgroundColor = '#fafafa';
        tableHeader.style.color = '#171717';
        tableHeader.style.borderTopColor = accent;
        tableHeader.style.borderBottomColor = accent;
      }
    }
  }

  // Sync Sidebar Controls with current state
  function syncSidebarInputs() {
    const docTypeSelect = document.getElementById('ctrl-doc-type') as HTMLSelectElement;
    if (docTypeSelect) {
      const match = DOCUMENT_TYPES.find(d => d.title === invoice.docTitle || d.label === invoice.docType);
      if (match) docTypeSelect.value = match.id;
    }

    const currSelect = document.getElementById('ctrl-currency') as HTMLSelectElement;
    if (currSelect && invoice.currency) currSelect.value = invoice.currency.code;

    const taxModeSelect = document.getElementById('ctrl-tax-mode') as HTMLSelectElement;
    if (taxModeSelect) taxModeSelect.value = invoice.taxMode || 'single';

    const singleTaxWrap = document.getElementById('ctrl-single-tax-wrap');
    const gstWrap = document.getElementById('ctrl-gst-wrap');
    if (invoice.taxMode === 'gst') {
      singleTaxWrap?.classList.add('hidden');
      gstWrap?.classList.remove('hidden');
    } else if (invoice.taxMode === 'none') {
      singleTaxWrap?.classList.add('hidden');
      gstWrap?.classList.add('hidden');
    } else {
      singleTaxWrap?.classList.remove('hidden');
      gstWrap?.classList.add('hidden');
    }

    const taxRateInput = document.getElementById('ctrl-tax-rate') as HTMLInputElement;
    if (taxRateInput) taxRateInput.value = invoice.taxRate?.toString() || '10';

    const taxRateDisplay = document.getElementById('ctrl-tax-rate-display');
    if (taxRateDisplay) taxRateDisplay.textContent = `${invoice.taxRate}%`;

    const discountVal = document.getElementById('ctrl-discount-val') as HTMLInputElement;
    if (discountVal) discountVal.value = invoice.discountValue?.toString() || '0';

    const discountType = document.getElementById('ctrl-discount-type') as HTMLSelectElement;
    if (discountType) discountType.value = invoice.discountType || 'percent';

    const shippingVal = document.getElementById('ctrl-shipping-val') as HTMLInputElement;
    if (shippingVal) shippingVal.value = invoice.shipping?.toString() || '0';

    const roundOffToggle = document.getElementById('ctrl-roundoff-toggle') as HTMLInputElement;
    if (roundOffToggle) roundOffToggle.checked = invoice.roundOff !== false;

    // Checkboxes for columns
    const colHsn = document.getElementById('ctrl-col-hsn') as HTMLInputElement;
    if (colHsn) colHsn.checked = !!invoice.columns?.hsn;

    const colUnit = document.getElementById('ctrl-col-unit') as HTMLInputElement;
    if (colUnit) colUnit.checked = !!invoice.columns?.unit;

    const colDisc = document.getElementById('ctrl-col-discount') as HTMLInputElement;
    if (colDisc) colDisc.checked = !!invoice.columns?.discount;
  }

