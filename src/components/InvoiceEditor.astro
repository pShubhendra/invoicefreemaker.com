  function bindVaultAndClientEvents() {
    // History search
    document.getElementById('history-search-input')?.addEventListener('input', (e) => {
      renderHistoryList((e.target as HTMLInputElement).value);
    });

    // Save current to vault button
    document.getElementById('btn-save-current-to-vault')?.addEventListener('click', (e) => {
      e.preventDefault();
      saveInvoiceToHistory(invoice);
      renderHistoryList();
      updateHistoryCount();
      alert('Invoice successfully saved to your browser vault!');
    });

    // Export Backup JSON
    document.getElementById('btn-export-backup-json')?.addEventListener('click', (e) => {
      e.preventDefault();
      const history = getInvoiceHistory();
      const blob = new Blob([JSON.stringify(history, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Invoice_Free_Maker_Backup_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Import Backup JSON
    document.getElementById('input-import-backup-json')?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const imported = JSON.parse(evt.target?.result as string);
            if (Array.isArray(imported)) {
              localStorage.setItem('ifm_invoice_history_v1', JSON.stringify(imported));
              renderHistoryList();
              updateHistoryCount();
              alert('Invoices backup successfully imported!');
            }
          } catch (err) {
            alert('Invalid backup JSON file.');
          }
        };
        reader.readAsText(file);
      }
    });

    // Client search
    document.getElementById('client-search-input')?.addEventListener('input', (e) => {
      renderClientList((e.target as HTMLInputElement).value);
    });

    // Save current client directly from active DOM fields (Requirement 6)
    document.getElementById('btn-save-current-client')?.addEventListener('click', (e) => {
      e.preventDefault();
      const clientName = document.getElementById('inv-client-name')?.textContent?.trim() || '';
      const clientAddress = document.getElementById('inv-client-address')?.textContent?.trim() || '';
      const clientEmail = document.getElementById('inv-client-email')?.textContent?.trim() || '';
      const clientPhone = document.getElementById('inv-client-phone')?.textContent?.trim() || '';
      const clientTaxId = document.getElementById('inv-client-taxid')?.textContent?.trim() || '';

      if (clientName) {
        saveClientToVault({
          name: clientName,
          address: clientAddress,
          email: clientEmail,
          phone: clientPhone,
          taxId: clientTaxId
        });
        renderClientList();
        alert(`Client "${clientName}" saved to Address Book with address & GST!`);
      } else {
        alert('Please enter a client name on the invoice first.');
      }
    });

    // Add custom client from form inside modal
    document.getElementById('btn-save-custom-client-form')?.addEventListener('click', (e) => {
      e.preventDefault();
      const name = (document.getElementById('cb-new-name') as HTMLInputElement)?.value?.trim();
      const email = (document.getElementById('cb-new-email') as HTMLInputElement)?.value?.trim();
      const phone = (document.getElementById('cb-new-phone') as HTMLInputElement)?.value?.trim();
      const address = (document.getElementById('cb-new-address') as HTMLTextAreaElement)?.value?.trim();
      const taxId = (document.getElementById('cb-new-taxid') as HTMLInputElement)?.value?.trim();

      if (name) {
        saveClientToVault({ name, email, phone, address, taxId });
        renderClientList();
        (document.getElementById('cb-new-name') as HTMLInputElement).value = '';
        (document.getElementById('cb-new-email') as HTMLInputElement).value = '';
        (document.getElementById('cb-new-phone') as HTMLInputElement).value = '';
        (document.getElementById('cb-new-address') as HTMLTextAreaElement).value = '';
        (document.getElementById('cb-new-taxid') as HTMLInputElement).value = '';
        alert(`Client "${name}" added to Address Book!`);
      } else {
        alert('Please enter a client name.');
      }
    });
  }

