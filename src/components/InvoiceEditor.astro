---
import SidebarControls from './editor/SidebarControls.astro';
import Canvas from './editor/Canvas.astro';
import SignatureModal from './editor/SignatureModal.astro';
import PaymentQrModal from './editor/PaymentQrModal.astro';
import InvoiceHistoryModal from './editor/InvoiceHistoryModal.astro';
import ClientBookModal from './editor/ClientBookModal.astro';
import CompanyManagerModal from './editor/CompanyManagerModal.astro';
import ItemCatalogModal from './editor/ItemCatalogModal.astro';
---

<section id="generator-section" class="py-8 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <div class="mb-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 no-print">
    <div>
      <span class="px-2 py-0.5 text-[10px] font-mono font-medium uppercase tracking-wider bg-black text-white rounded">Live Studio</span>
      <h2 class="text-2xl font-bold tracking-tight text-[#171717] mt-1">Interactive Invoice Generator</h2>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <button id="quick-btn-companies" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
        My Companies
      </button>
      <button id="quick-btn-items" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
        Item Catalog
      </button>
      <button id="quick-btn-clients" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        Address Book
      </button>
      <button id="quick-btn-sig" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
        Signature
      </button>
      <button id="quick-btn-qr" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm cursor-pointer flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
        Payment QR
      </button>
    </div>
  </div>

  <div class="flex flex-col lg:flex-row items-start gap-6">
    <Canvas />
    <SidebarControls />
  </div>

  <SignatureModal />
  <PaymentQrModal />
  <InvoiceHistoryModal />
  <ClientBookModal />
  <CompanyManagerModal />
  <ItemCatalogModal />
</section>

<script>
import {
  getDefaultInvoice, calculateTotals, saveCurrentInvoiceToStorage,
  loadCurrentInvoiceFromStorage, getInvoiceHistory, saveInvoiceToHistory,
  deleteInvoiceFromHistory, duplicateInvoiceInHistory,
  getClientsVault, saveClientToVault, deleteClientFromVault,
  getCompaniesVault, saveCompanyToVault, deleteCompanyFromVault,
  getItemsCatalog, saveItemToCatalog, deleteItemFromCatalog,
  importInvoiceHistory,
  CURRENCIES, DOCUMENT_TYPES
} from '../scripts/invoice-state.js';
import { generatePaymentQRCode } from '../scripts/qr-generator.js';
import { exportInvoiceToPDF, exportInvoiceToPNG, generateWhatsAppShareLink, generateEmailShareLink } from '../scripts/pdf-generator.js';

let invoice = loadCurrentInvoiceFromStorage();
let sigPadDrawing = false;
let sigUndoStack = [];
let sigColor = '#171717';
let sigTab = 'draw';
let qrTab = 'upi';
let isInitialized = false;

// Modal open/close helpers (used by both bindEvents and bindPaperEvents)
const openModal = id => document.getElementById(id)?.classList.remove('hidden');
const closeModal = id => document.getElementById(id)?.classList.add('hidden');

function init() {
  if (isInitialized) return;
  isInitialized = true;
  applyTemplate();
  bindEvents();
  initSigCanvas();
}

function applyTemplate() {
  const paper = document.getElementById('invoice-paper');
  if (!paper) return;
  const themeId = invoice.theme || 'gst_tally';
  const tpl = document.getElementById('tmpl-' + themeId) || document.getElementById('tmpl-gst_tally');
  if (!tpl) return;
  paper.innerHTML = '';
  paper.appendChild(tpl.content.cloneNode(true));
  bindPaperEvents();
  renderAll();
}

// Bind events for elements living inside the active invoice paper template.
// Re-run after every applyTemplate() since cloning replaces the DOM.
function bindPaperEvents() {
  // Contenteditable invoice fields
  const bindBlur = (id, setter) => {
    document.getElementById(id)?.addEventListener('blur', e => {
      setter(e.target.textContent?.trim() || '');
      saveCurrentInvoiceToStorage(invoice);
    });
  };
  bindBlur('inv-sender-name', v => invoice.sender.name = v);
  bindBlur('inv-sender-address', v => invoice.sender.address = v);
  bindBlur('inv-sender-email', v => invoice.sender.email = v);
  bindBlur('inv-sender-phone', v => invoice.sender.phone = v);
  bindBlur('inv-sender-taxid', v => invoice.sender.taxId = v);
  bindBlur('inv-client-name', v => invoice.client.name = v);
  bindBlur('inv-client-address', v => invoice.client.address = v);
  bindBlur('inv-client-email', v => invoice.client.email = v);
  bindBlur('inv-client-taxid', v => invoice.client.taxId = v);
  bindBlur('inv-doc-title', v => invoice.docTitle = v);
  bindBlur('inv-number', v => invoice.invoiceNumber = v);
  bindBlur('inv-notes', v => invoice.notes = v);
  bindBlur('inv-terms', v => invoice.terms = v);
  bindBlur('bank-name', v => invoice.paymentDetails.bankName = v);
  bindBlur('bank-holder', v => invoice.paymentDetails.accountName = v);
  bindBlur('bank-account', v => invoice.paymentDetails.accountNumber = v);
  bindBlur('bank-ifsc', v => invoice.paymentDetails.swift = v);

  // Input fields
  document.getElementById('inv-issue-date')?.addEventListener('change', e => {
    invoice.issueDate = e.target.value; saveCurrentInvoiceToStorage(invoice);
  });
  document.getElementById('inv-due-date')?.addEventListener('change', e => {
    invoice.dueDate = e.target.value; saveCurrentInvoiceToStorage(invoice);
  });
  document.getElementById('inv-po-number')?.addEventListener('input', e => {
    invoice.referenceNumber = e.target.value; saveCurrentInvoiceToStorage(invoice);
  });

  // Logo
  const logoWrap = document.getElementById('logo-display-wrap');
  const logoInput = document.getElementById('logo-file-input');
  logoWrap?.addEventListener('click', () => logoInput?.click());
  logoInput?.addEventListener('change', e => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = ev => { invoice.sender.logo = ev.target.result; renderAll(); };
      reader.readAsDataURL(file);
    }
  });
  document.getElementById('btn-remove-logo')?.addEventListener('click', e => {
    e.stopPropagation(); invoice.sender.logo = ''; renderAll();
  });

  // Add line item
  document.getElementById('btn-add-line-item')?.addEventListener('click', e => {
    e.preventDefault();
    invoice.items.push({ id: 'i' + Date.now(), description: 'New Item or Service', hsn: '1005', unit: 'No', quantity: 1, rate: 0, discount: 0, discountType: 'percent', taxRate: 18 });
    renderAll();
  });

  // Paper-internal modal launchers (quick buttons inside the canvas)
  document.getElementById('btn-quick-fill-client')?.addEventListener('click', () => { openModal('client-book-modal'); renderClientList(); });
  document.getElementById('btn-quick-switch-company')?.addEventListener('click', () => { openModal('company-manager-modal'); renderCompanyList(); });
  document.getElementById('btn-open-item-catalog')?.addEventListener('click', () => { openModal('item-catalog-modal'); renderCatalogList(); });
}

// ─── RENDER ENGINE ───────────────────────────────────────────────────────────

function renderAll() {
  const totals = calculateTotals(invoice);
  const sym = invoice.currency?.symbol || '₹';

  applyAccentColor();
  renderHeader(sym);
  renderLineItems(sym, totals);
  renderTotals(totals, sym);
  renderSignature();
  renderQR(totals.grandTotal);
  syncSidebar();
  saveCurrentInvoiceToStorage(invoice);

  const badge = document.getElementById('history-count-badge');
  if (badge) badge.textContent = getInvoiceHistory().length.toString();
}

function applyAccentColor() {
  const paper = document.getElementById('invoice-paper');
  if (!paper) return;
  const accent = invoice.accentColor || '#171717';
  paper.style.setProperty('--inv-accent', accent);

  // Update rate header cell text
  const rateHeader = document.getElementById('inv-rate-header');
  if (rateHeader) rateHeader.textContent = `Rate (${invoice.currency?.symbol || '₹'})`;
}

function renderHeader(sym) {
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || ''; };
  const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };

  set('inv-sender-name', invoice.sender?.name);
  set('inv-sender-address', invoice.sender?.address);
  set('inv-sender-email', invoice.sender?.email);
  set('inv-sender-phone', invoice.sender?.phone);
  set('inv-sender-taxid', invoice.sender?.taxId);
  set('inv-doc-title', invoice.docTitle || 'TAX INVOICE');
  set('inv-number', invoice.invoiceNumber);
  setVal('inv-issue-date', invoice.issueDate);
  setVal('inv-due-date', invoice.dueDate);
  setVal('inv-po-number', invoice.referenceNumber || '');
  set('inv-client-name', invoice.client?.name);
  set('inv-client-address', invoice.client?.address);
  set('inv-client-email', invoice.client?.email);
  set('inv-client-taxid', invoice.client?.taxId);
  set('inv-notes', invoice.notes);
  set('inv-terms', invoice.terms);
  set('bank-name', invoice.paymentDetails?.bankName);
  set('bank-holder', invoice.paymentDetails?.accountName);
  set('bank-account', invoice.paymentDetails?.accountNumber);
  set('bank-ifsc', invoice.paymentDetails?.swift || invoice.paymentDetails?.routingNumber);

  // Logo
  const logoImg = document.getElementById('sender-logo-img');
  const logoPlh = document.getElementById('logo-placeholder');
  const removeLogo = document.getElementById('btn-remove-logo');
  if (invoice.sender?.logo) {
    logoImg?.setAttribute('src', invoice.sender.logo);
    logoImg?.setAttribute('alt', `${invoice.sender?.name || 'Company'} logo`);
    logoImg?.classList.remove('hidden');
    logoPlh?.classList.add('hidden');
    removeLogo?.classList.remove('hidden');
  } else {
    logoImg?.classList.add('hidden');
    logoPlh?.classList.remove('hidden');
    removeLogo?.classList.add('hidden');
  }
}

function renderLineItems(sym, totals) {
  const tbody = document.getElementById('inv-items-body');
  if (!tbody) return;
  tbody.innerHTML = '';

  const showHsn = invoice.columns?.hsn !== false;
  const showUnit = invoice.columns?.unit !== false;
  const showDisc = invoice.columns?.discount !== false;

  // Sync column header visibility
  document.querySelectorAll('.col-hsn').forEach(el => el.classList.toggle('hidden', !showHsn));
  document.querySelectorAll('.col-unit').forEach(el => el.classList.toggle('hidden', !showUnit));
  document.querySelectorAll('.col-discount').forEach(el => el.classList.toggle('hidden', !showDisc));

  invoice.items.forEach((item, idx) => {
    const qty = Number(item.quantity) || 0;
    const rate = Number(item.rate) || 0;
    let lineTotal = qty * rate;
    if (showDisc && item.discount) {
      const d = Number(item.discount);
      lineTotal -= item.discountType === 'fixed' ? d : (lineTotal * d / 100);
    }
    lineTotal = Math.max(0, lineTotal);

    const tr = document.createElement('tr');
    tr.className = 'group hover:bg-[#fafafa] transition-colors';
    tr.innerHTML = `
      <td class="py-2.5 px-3 text-center text-[#888888] font-mono">${idx + 1}</td>
      <td class="py-2.5 px-3">
        <div class="item-desc font-medium text-[#171717] outline-none min-w-[80px]" contenteditable="true">${escHtml(item.description || '')}</div>
      </td>
      <td class="py-2.5 px-2 text-center col-hsn ${showHsn ? '' : 'hidden'}">
        <input type="text" value="${escHtml(item.hsn || '')}" class="item-hsn w-full text-center font-mono text-xs bg-transparent border-0 outline-none focus:bg-[#fafafa] focus:ring-1 focus:ring-[#171717] rounded px-1 py-0.5" />
      </td>
      <td class="py-2.5 px-2 text-center col-unit ${showUnit ? '' : 'hidden'}">
        <input type="text" value="${escHtml(item.unit || 'No')}" class="item-unit w-full text-center text-xs bg-transparent border-0 outline-none focus:bg-[#fafafa] focus:ring-1 focus:ring-[#171717] rounded px-1 py-0.5" />
      </td>
      <td class="py-2.5 px-3 text-right">
        <input type="number" value="${qty}" min="0" step="any" class="item-qty w-16 text-right font-mono font-medium bg-transparent border-0 outline-none focus:bg-[#fafafa] focus:ring-1 focus:ring-[#171717] rounded px-1 py-0.5" />
      </td>
      <td class="py-2.5 px-3 text-right">
        <input type="number" value="${rate}" min="0" step="any" class="item-rate w-20 text-right font-mono font-medium bg-transparent border-0 outline-none focus:bg-[#fafafa] focus:ring-1 focus:ring-[#171717] rounded px-1 py-0.5" />
      </td>
      <td class="py-2.5 px-2 text-right col-discount ${showDisc ? '' : 'hidden'}">
        <input type="number" value="${item.discount || 0}" min="0" step="any" class="item-disc w-14 text-right font-mono bg-transparent border-0 outline-none focus:bg-[#fafafa] focus:ring-1 focus:ring-[#171717] rounded px-1 py-0.5" />
      </td>
      <td class="py-2.5 px-3 text-right font-mono font-bold text-[#171717]">
        ${sym}${lineTotal.toFixed(2)}
      </td>
      <td class="py-2.5 px-2 text-center no-print">
        <button type="button" class="btn-del-row opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 font-bold cursor-pointer p-1 transition-opacity">×</button>
      </td>
    `;

    // Inline events
    tr.querySelector('.item-desc')?.addEventListener('blur', e => {
      invoice.items[idx].description = e.target.textContent.trim();
      saveCurrentInvoiceToStorage(invoice);
    });
    tr.querySelector('.item-hsn')?.addEventListener('input', e => {
      invoice.items[idx].hsn = e.target.value;
      saveCurrentInvoiceToStorage(invoice);
    });
    tr.querySelector('.item-unit')?.addEventListener('input', e => {
      invoice.items[idx].unit = e.target.value;
      saveCurrentInvoiceToStorage(invoice);
    });
    tr.querySelector('.item-qty')?.addEventListener('input', e => {
      invoice.items[idx].quantity = parseFloat(e.target.value) || 0;
      renderAll();
    });
    tr.querySelector('.item-rate')?.addEventListener('input', e => {
      invoice.items[idx].rate = parseFloat(e.target.value) || 0;
      renderAll();
    });
    tr.querySelector('.item-disc')?.addEventListener('input', e => {
      invoice.items[idx].discount = parseFloat(e.target.value) || 0;
      renderAll();
    });
    tr.querySelector('.btn-del-row')?.addEventListener('click', e => {
      e.stopPropagation();
      if (invoice.items.length > 1) {
        invoice.items.splice(idx, 1);
        renderAll();
      }
    });

    tbody.appendChild(tr);
  });
}

function renderTotals(totals, sym) {
  const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  const show = (id, visible) => { const el = document.getElementById(id); if (el) el.classList.toggle('hidden', !visible); el?.classList.toggle('flex', visible); };

  set('sum-subtotal', `${sym}${totals.subtotal.toFixed(2)}`);
  set('sum-grandtotal', `${sym}${totals.grandTotal.toFixed(2)}`);

  if (totals.invoiceDiscount > 0) {
    show('sum-row-invdisc', true);
    set('sum-invdisc', `-${sym}${totals.invoiceDiscount.toFixed(2)}`);
  } else {
    show('sum-row-invdisc', false);
  }

  if (invoice.taxMode === 'gst') {
    show('sum-row-tax', false);
    if (invoice.isInterstateGST) {
      show('sum-row-cgst', false);
      show('sum-row-sgst', false);
      show('sum-row-igst', true);
      set('sum-igst-label', `IGST (${invoice.igstRate}%)`);
      set('sum-igst', `${sym}${totals.igstAmount.toFixed(2)}`);
    } else {
      show('sum-row-igst', false);
      show('sum-row-cgst', true);
      show('sum-row-sgst', true);
      set('sum-cgst-label', `CGST (${invoice.cgstRate}%)`);
      set('sum-cgst', `${sym}${totals.cgstAmount.toFixed(2)}`);
      set('sum-sgst-label', `SGST (${invoice.sgstRate}%)`);
      set('sum-sgst', `${sym}${totals.sgstAmount.toFixed(2)}`);
    }
  } else if (invoice.taxMode === 'none') {
    show('sum-row-tax', false); show('sum-row-cgst', false); show('sum-row-sgst', false); show('sum-row-igst', false);
  } else {
    show('sum-row-cgst', false); show('sum-row-sgst', false); show('sum-row-igst', false);
    show('sum-row-tax', true);
    set('sum-tax-label', `Tax (${invoice.taxRate}%)`);
    set('sum-tax', `${sym}${totals.taxAmount.toFixed(2)}`);
  }

  if (totals.shipping > 0) {
    show('sum-row-shipping', true);
    set('sum-shipping', `${sym}${totals.shipping.toFixed(2)}`);
  } else {
    show('sum-row-shipping', false);
  }

  set('inv-amount-words', totals.amountInWords);
}

function renderSignature() {
  const sigType = invoice.signature?.type || 'type';
  const sigName = invoice.signature?.typedName || 'Authorised Signatory';
  const sigTitle = invoice.signature?.title || '';

  const img = document.getElementById('sig-display-img');
  const txt = document.getElementById('sig-display-text');
  const nameEl = document.getElementById('inv-sig-name');
  const titleEl = document.getElementById('inv-sig-title');

  if (nameEl) nameEl.textContent = sigName;
  if (titleEl) titleEl.textContent = sigTitle || `for ${invoice.sender?.name || ''}`;

  if (sigType === 'draw' || sigType === 'upload') {
    if (invoice.signature?.dataUrl && img) {
      img.src = invoice.signature.dataUrl;
      img.classList.remove('hidden');
    }
    txt?.classList.add('hidden');
  } else {
    img?.classList.add('hidden');
    if (txt) {
      txt.classList.remove('hidden');
      txt.textContent = sigName;
      txt.style.fontFamily = `'${invoice.signature?.fontFamily || 'Caveat'}', cursive`;
    }
  }
}

async function renderQR(grandTotal) {
  if (!invoice.qrCode?.enabled) {
    document.getElementById('inv-qr-section')?.classList.add('hidden');
    return;
  }
  document.getElementById('inv-qr-section')?.classList.remove('hidden');

  const result = await generatePaymentQRCode(invoice.qrCode, grandTotal, invoice.currency?.code, invoice.invoiceNumber);
  if (result?.dataUrl) {
    const img = document.getElementById('inv-qr-img');
    if (img) img.src = result.dataUrl;
    invoice.qrCode.qrDataUrl = result.dataUrl;
  }
  const desc = document.getElementById('inv-qr-desc');
  if (desc) {
    const t = invoice.qrCode.type;
    desc.textContent = t === 'upi' ? `UPI: ${invoice.qrCode.upiId || ''}` : t === 'paypal' ? 'PayPal Checkout' : 'Scan to Pay';
  }
}

function syncSidebar() {
  const taxMode = document.getElementById('ctrl-tax-mode');
  if (taxMode) taxMode.value = invoice.taxMode || 'gst';

  const gstWrap = document.getElementById('ctrl-gst-wrap');
  const singleWrap = document.getElementById('ctrl-single-tax-wrap');
  if (invoice.taxMode === 'gst') {
    gstWrap?.classList.remove('hidden');
    singleWrap?.classList.add('hidden');
  } else if (invoice.taxMode === 'none') {
    gstWrap?.classList.add('hidden');
    singleWrap?.classList.add('hidden');
  } else {
    gstWrap?.classList.add('hidden');
    singleWrap?.classList.remove('hidden');
  }

  const discVal = document.getElementById('ctrl-discount-val');
  if (discVal) discVal.value = invoice.discountValue || 0;

  const shippingVal = document.getElementById('ctrl-shipping-val');
  if (shippingVal) shippingVal.value = invoice.shipping || 0;

  const roundOff = document.getElementById('ctrl-roundoff-toggle');
  if (roundOff) roundOff.checked = invoice.roundOff !== false;

  const currSel = document.getElementById('ctrl-currency');
  if (currSel && invoice.currency) currSel.value = invoice.currency.code;

  const docType = document.getElementById('ctrl-doc-type');
  if (docType) {
    const match = DOCUMENT_TYPES.find(d => d.title === invoice.docTitle);
    if (match) docType.value = match.id;
  }

  const tplSel = document.getElementById('ctrl-template');
  if (tplSel && invoice.theme) tplSel.value = invoice.theme;

  // Column checkboxes
  const hsnCb = document.getElementById('ctrl-col-hsn');
  if (hsnCb) hsnCb.checked = invoice.columns?.hsn !== false;
  const unitCb = document.getElementById('ctrl-col-unit');
  if (unitCb) unitCb.checked = invoice.columns?.unit !== false;
  const discCb = document.getElementById('ctrl-col-discount');
  if (discCb) discCb.checked = invoice.columns?.discount !== false;

  // Accent color buttons
  document.querySelectorAll('.ctrl-color-btn').forEach(btn => {
    const active = btn.dataset.color === (invoice.accentColor || '#171717');
    btn.classList.toggle('ring-2', active);
    btn.classList.toggle('ring-offset-2', active);
    btn.classList.toggle('ring-[#171717]', active);
    btn.classList.toggle('scale-110', active);
  });

  const accentPicker = document.getElementById('ctrl-accent-picker');
  if (accentPicker) accentPicker.value = invoice.accentColor || '#171717';
}

// ─── BIND ALL EVENTS (single call) ──────────────────────────────────────────

function bindEvents() {
  // Sidebar controls
  document.getElementById('ctrl-doc-type')?.addEventListener('change', e => {
    const found = DOCUMENT_TYPES.find(d => d.id === e.target.value);
    if (found) { invoice.docTitle = found.title; invoice.docType = found.label; renderAll(); }
  });
  document.getElementById('ctrl-template')?.addEventListener('change', e => {
    invoice.theme = e.target.value;
    applyTemplate();
    saveCurrentInvoiceToStorage(invoice);
  });
  document.getElementById('ctrl-currency')?.addEventListener('change', e => {
    const found = CURRENCIES.find(c => c.code === e.target.value);
    if (found) { invoice.currency = found; renderAll(); }
  });
  document.getElementById('ctrl-tax-mode')?.addEventListener('change', e => {
    invoice.taxMode = e.target.value; renderAll();
  });
  document.getElementById('ctrl-tax-rate')?.addEventListener('input', e => {
    invoice.taxRate = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-cgst-rate')?.addEventListener('input', e => {
    invoice.cgstRate = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-sgst-rate')?.addEventListener('input', e => {
    invoice.sgstRate = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-igst-rate')?.addEventListener('input', e => {
    invoice.igstRate = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-gst-interstate')?.addEventListener('change', e => {
    invoice.isInterstateGST = e.target.checked;
    document.getElementById('ctrl-intra-rates')?.classList.toggle('hidden', e.target.checked);
    document.getElementById('ctrl-inter-rate')?.classList.toggle('hidden', !e.target.checked);
    renderAll();
  });
  document.getElementById('ctrl-discount-val')?.addEventListener('input', e => {
    invoice.discountValue = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-discount-type')?.addEventListener('change', e => {
    invoice.discountType = e.target.value; renderAll();
  });
  document.getElementById('ctrl-shipping-val')?.addEventListener('input', e => {
    invoice.shipping = parseFloat(e.target.value) || 0; renderAll();
  });
  document.getElementById('ctrl-roundoff-toggle')?.addEventListener('change', e => {
    invoice.roundOff = e.target.checked; renderAll();
  });

  // Accent color buttons — update CSS custom property immediately
  document.querySelectorAll('.ctrl-color-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const col = btn.dataset.color;
      if (!col) return;
      invoice.accentColor = col;
      const paper = document.getElementById('invoice-paper');
      if (paper) paper.style.setProperty('--inv-accent', col);
      // Sync ring on buttons
      document.querySelectorAll('.ctrl-color-btn').forEach(b => {
        b.classList.toggle('ring-2', false);
        b.classList.toggle('ring-offset-2', false);
        b.classList.toggle('scale-110', false);
      });
      btn.classList.add('ring-2', 'ring-offset-2', 'scale-110');
      const nameEl = document.getElementById('ctrl-active-color-name');
      if (nameEl) nameEl.textContent = col;
      // Re-render to update dynamic elements
      renderAll();
      saveCurrentInvoiceToStorage(invoice);
    });
  });

  // Custom accent color picker — any color, any shade
  const accentPicker = document.getElementById('ctrl-accent-picker');
  accentPicker?.addEventListener('input', e => {
    const col = e.target.value;
    invoice.accentColor = col;
    const paper = document.getElementById('invoice-paper');
    if (paper) paper.style.setProperty('--inv-accent', col);
    document.querySelectorAll('.ctrl-color-btn').forEach(b => {
      b.classList.toggle('ring-2', false);
      b.classList.toggle('ring-offset-2', false);
      b.classList.toggle('scale-110', false);
    });
    const nameEl = document.getElementById('ctrl-active-color-name');
    if (nameEl) nameEl.textContent = col;
    renderAll();
    saveCurrentInvoiceToStorage(invoice);
  });

  // Column toggles
  document.getElementById('ctrl-col-hsn')?.addEventListener('change', e => {
    if (!invoice.columns) invoice.columns = {};
    invoice.columns.hsn = e.target.checked;
    renderAll();
  });
  document.getElementById('ctrl-col-unit')?.addEventListener('change', e => {
    if (!invoice.columns) invoice.columns = {};
    invoice.columns.unit = e.target.checked;
    renderAll();
  });
  document.getElementById('ctrl-col-discount')?.addEventListener('change', e => {
    if (!invoice.columns) invoice.columns = {};
    invoice.columns.discount = e.target.checked;
    renderAll();
  });

  // Export / Share
  const handlePDF = async e => {
    e.preventDefault();
    const btn = document.getElementById('btn-download-pdf');
    const orig = btn?.innerHTML;
    if (btn) btn.innerHTML = '<span>Generating...</span>';
    try {
      const fname = `${invoice.invoiceNumber || 'Invoice'}_${(invoice.client?.name || 'Client').replace(/\s+/g, '_')}.pdf`;
      await exportInvoiceToPDF('invoice-paper', fname);
      saveInvoiceToHistory(invoice);
    } catch(e) { console.error(e); }
    finally { if (btn && orig) btn.innerHTML = orig; }
  };
  document.getElementById('btn-download-pdf')?.addEventListener('click', handlePDF);
  document.getElementById('btn-print-invoice')?.addEventListener('click', e => { e.preventDefault(); window.print(); });
  document.getElementById('btn-download-png')?.addEventListener('click', e => {
    e.preventDefault(); exportInvoiceToPNG('invoice-paper', `${invoice.invoiceNumber || 'Invoice'}.png`);
  });
  document.getElementById('btn-share-whatsapp')?.addEventListener('click', e => {
    e.preventDefault(); window.open(generateWhatsAppShareLink(invoice, calculateTotals(invoice)), '_blank');
  });
  document.getElementById('btn-share-email')?.addEventListener('click', e => {
    e.preventDefault(); window.location.href = generateEmailShareLink(invoice, calculateTotals(invoice));
  });

  document.getElementById('btn-new-invoice')?.addEventListener('click', e => {
    e.preventDefault();
    if (confirm('Create a new blank invoice? Current will be saved to Vault.')) {
      saveInvoiceToHistory(invoice);
      invoice = getDefaultInvoice();
      invoice.invoiceNumber = `INV-${new Date().getFullYear()}-${Math.floor(100 + Math.random()*900)}`;
      renderAll();
    }
  });
  document.getElementById('btn-reset-sample')?.addEventListener('click', e => {
    e.preventDefault();
    if (confirm('Load sample invoice data?')) { invoice = getDefaultInvoice(); renderAll(); }
  });

  // Modal open/close helpers
  // (openModal/closeModal are module-level, defined above)

  // Signature modal
  const sigTriggers = ['btn-sidebar-open-sig', 'quick-btn-sig'];
  sigTriggers.forEach(id => document.getElementById(id)?.addEventListener('click', () => openModal('signature-modal')));
  document.getElementById('btn-close-sig-modal')?.addEventListener('click', () => closeModal('signature-modal'));
  document.getElementById('btn-cancel-sig')?.addEventListener('click', () => closeModal('signature-modal'));

  // QR modal
  const qrTriggers = ['btn-sidebar-open-qr', 'quick-btn-qr'];
  qrTriggers.forEach(id => document.getElementById(id)?.addEventListener('click', () => {
    openModal('payment-qr-modal');
    updateQRPreview();
  }));
  document.getElementById('btn-close-qr-modal')?.addEventListener('click', () => closeModal('payment-qr-modal'));
  document.getElementById('btn-cancel-qr')?.addEventListener('click', () => closeModal('payment-qr-modal'));

  // History modal
  document.getElementById('btn-open-history')?.addEventListener('click', () => { openModal('invoice-history-modal'); renderHistoryList(); });
  document.getElementById('btn-close-history-modal')?.addEventListener('click', () => closeModal('invoice-history-modal'));

  // Client modal
  ['btn-sidebar-open-clients', 'quick-btn-clients'].forEach(id =>
    document.getElementById(id)?.addEventListener('click', () => { openModal('client-book-modal'); renderClientList(); })
  );
  document.getElementById('btn-close-client-modal')?.addEventListener('click', () => closeModal('client-book-modal'));

  // Company modal
  ['btn-sidebar-open-companies', 'quick-btn-companies'].forEach(id =>
    document.getElementById(id)?.addEventListener('click', () => { openModal('company-manager-modal'); renderCompanyList(); })
  );
  document.getElementById('btn-close-company-modal')?.addEventListener('click', () => closeModal('company-manager-modal'));

  // Catalog modal
  ['btn-sidebar-open-catalog', 'quick-btn-items'].forEach(id =>
    document.getElementById(id)?.addEventListener('click', () => { openModal('item-catalog-modal'); renderCatalogList(); })
  );
  document.getElementById('btn-close-item-modal')?.addEventListener('click', () => closeModal('item-catalog-modal'));

  // Signature studio
  bindSigStudio();

  // QR studio
  bindQRStudio();

  // Vault events
  document.getElementById('btn-save-current-to-vault')?.addEventListener('click', e => {
    e.preventDefault();
    saveInvoiceToHistory(invoice);
    renderHistoryList();
    const badge = document.getElementById('history-count-badge');
    if (badge) badge.textContent = getInvoiceHistory().length.toString();
    alert('Invoice saved to Vault!');
  });
  document.getElementById('history-search-input')?.addEventListener('input', e => renderHistoryList(e.target.value));

  document.getElementById('btn-save-current-client')?.addEventListener('click', e => {
    e.preventDefault();
    if (invoice.client?.name) {
      saveClientToVault(invoice.client);
      renderClientList();
      alert(`"${invoice.client.name}" saved!`);
    }
  });
  document.getElementById('btn-save-current-as-company')?.addEventListener('click', e => {
    e.preventDefault();
    if (invoice.sender?.name) {
      saveCompanyToVault(invoice.sender);
      renderCompanyList();
      alert(`"${invoice.sender.name}" company profile saved!`);
    }
  });
  document.getElementById('btn-save-new-catalog-item')?.addEventListener('click', e => {
    e.preventDefault();
    const desc = document.getElementById('catalog-desc-input')?.value?.trim();
    const hsn = document.getElementById('catalog-hsn-input')?.value?.trim();
    const rate = parseFloat(document.getElementById('catalog-rate-input')?.value) || 0;
    if (desc) {
      saveItemToCatalog({ description: desc, hsn, unit: 'No', rate, taxRate: 18 });
      renderCatalogList();
      document.getElementById('catalog-desc-input').value = '';
      document.getElementById('catalog-hsn-input').value = '';
      document.getElementById('catalog-rate-input').value = '';
    }
  });

  document.getElementById('btn-export-backup-json')?.addEventListener('click', e => {
    e.preventDefault();
    const h = getInvoiceHistory();
    const blob = new Blob([JSON.stringify(h, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url;
    a.download = `IFM_Backup_${new Date().toISOString().split('T')[0]}.json`; a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('input-import-backup-json')?.addEventListener('change', e => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        const count = importInvoiceHistory(data);
        renderHistoryList();
        const badge = document.getElementById('history-count-badge');
        if (badge) badge.textContent = getInvoiceHistory().length.toString();
        alert(count > 0 ? `Imported ${count} invoice${count > 1 ? 's' : ''} to your Vault.` : 'No valid invoices found in that file.');
      } catch (err) {
        console.error(err);
        alert('Invalid JSON backup file. Please select the JSON exported from the Vault.');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });
}

// ─── SIGNATURE STUDIO ────────────────────────────────────────────────────────

function initSigCanvas() {
  const canvas = document.getElementById('sig-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  ctx.lineWidth = 2.5; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = sigColor;

  const pos = (e) => {
    const r = canvas.getBoundingClientRect();
    const src = e.touches ? e.touches[0] : e;
    return { x: src.clientX - r.left, y: src.clientY - r.top };
  };

  canvas.addEventListener('mousedown', e => { sigPadDrawing = true; const p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); });
  canvas.addEventListener('mousemove', e => { if (!sigPadDrawing) return; const p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); });
  canvas.addEventListener('mouseup', () => { sigPadDrawing = false; sigUndoStack.push(ctx.getImageData(0, 0, canvas.width, canvas.height)); });
  canvas.addEventListener('mouseleave', () => { sigPadDrawing = false; });
  canvas.addEventListener('touchstart', e => { e.preventDefault(); sigPadDrawing = true; const p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }, { passive: false });
  canvas.addEventListener('touchmove', e => { e.preventDefault(); if (!sigPadDrawing) return; const p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); }, { passive: false });
  canvas.addEventListener('touchend', e => { e.preventDefault(); sigPadDrawing = false; sigUndoStack.push(ctx.getImageData(0, 0, canvas.width, canvas.height)); }, { passive: false });
}

function bindSigStudio() {
  const tabs = { draw: { tab: 'sig-tab-draw', content: 'sig-content-draw' }, type: { tab: 'sig-tab-type', content: 'sig-content-type' }, upload: { tab: 'sig-tab-upload', content: 'sig-content-upload' } };
  const switchTab = name => {
    sigTab = name;
    Object.entries(tabs).forEach(([k, v]) => {
      document.getElementById(v.tab)?.classList.toggle('bg-white', k === name);
      document.getElementById(v.tab)?.classList.toggle('text-[#171717]', k === name);
      document.getElementById(v.tab)?.classList.toggle('shadow-xs', k === name);
      document.getElementById(v.content)?.classList.toggle('hidden', k !== name);
    });
  };
  Object.keys(tabs).forEach(k => document.getElementById(tabs[k].tab)?.addEventListener('click', () => switchTab(k)));

  document.getElementById('btn-clear-sig')?.addEventListener('click', () => {
    const c = document.getElementById('sig-canvas'); const ctx = c?.getContext('2d');
    if (ctx && c) { ctx.clearRect(0, 0, c.width, c.height); sigUndoStack = []; }
  });
  document.getElementById('btn-undo-sig')?.addEventListener('click', () => {
    const c = document.getElementById('sig-canvas'); const ctx = c?.getContext('2d');
    if (ctx && c && sigUndoStack.length > 0) {
      sigUndoStack.pop();
      if (sigUndoStack.length > 0) ctx.putImageData(sigUndoStack[sigUndoStack.length-1], 0, 0);
      else ctx.clearRect(0, 0, c.width, c.height);
    }
  });

  const typedInput = document.getElementById('sig-typed-input');
  typedInput?.addEventListener('input', () => {
    const n = typedInput.value || 'Authorised Signatory';
    ['preview-font-1','preview-font-2'].forEach(id => { const el = document.getElementById(id); if(el) el.textContent = n; });
  });

  document.querySelectorAll('.sig-font-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.sig-font-card').forEach(c => c.classList.remove('ring-2','ring-[#171717]'));
      card.classList.add('ring-2','ring-[#171717]');
      card.querySelector('input[type="radio"]').checked = true;
    });
  });

  const sigFileInput = document.getElementById('sig-file-input');
  sigFileInput?.addEventListener('change', e => {
    const f = e.target.files?.[0];
    if (f) { const r = new FileReader(); r.onload = ev => { invoice.signature.type='upload'; invoice.signature.dataUrl = ev.target.result; renderSignature(); }; r.readAsDataURL(f); }
  });

  document.getElementById('btn-apply-sig')?.addEventListener('click', () => {
    const name = document.getElementById('sig-signer-name')?.value || 'Authorised Signatory';
    invoice.signature.enabled = true;
    invoice.signature.typedName = name;
    invoice.signature.title = `for ${invoice.sender?.name || ''}`;

    if (sigTab === 'draw') {
      const c = document.getElementById('sig-canvas');
      invoice.signature.type = 'draw';
      invoice.signature.dataUrl = c?.toDataURL('image/png') || '';
    } else if (sigTab === 'type') {
      invoice.signature.type = 'type';
      invoice.signature.fontFamily = document.querySelector('input[name="sig-font-choice"]:checked')?.value || 'Caveat';
      invoice.signature.typedName = document.getElementById('sig-typed-input')?.value || name;
    }
    renderSignature();
    document.getElementById('signature-modal')?.classList.add('hidden');
  });
}

// ─── QR STUDIO ───────────────────────────────────────────────────────────────

async function updateQRPreview() {
  const upiId = document.getElementById('qr-upi-id')?.value || '';
  const upiName = document.getElementById('qr-upi-name')?.value || '';
  const paypalUrl = document.getElementById('qr-paypal-url')?.value || '';
  const customUrl = document.getElementById('qr-custom-url')?.value || '';

  const result = await generatePaymentQRCode({
    enabled: true, type: qrTab, upiId, upiName, paypalUrl, customUrl
  }, 0, 'INR', invoice.invoiceNumber);

  const img = document.getElementById('qr-preview-img');
  if (img && result?.dataUrl) { img.src = result.dataUrl; img.classList.remove('hidden'); }
}

function bindQRStudio() {
  const qrTabs = ['upi','paypal','custom'];
  qrTabs.forEach(t => {
    document.getElementById(`qr-tab-${t}`)?.addEventListener('click', () => {
      qrTab = t;
      qrTabs.forEach(k => {
        document.getElementById(`qr-tab-${k}`)?.classList.toggle('bg-white', k===t);
        document.getElementById(`qr-tab-${k}`)?.classList.toggle('text-[#171717]', k===t);
        document.getElementById(`qr-tab-${k}`)?.classList.toggle('shadow-xs', k===t);
        document.getElementById(`qr-content-${k}`)?.classList.toggle('hidden', k!==t);
      });
      updateQRPreview();
    });
  });
  ['qr-upi-id','qr-upi-name','qr-paypal-url','qr-custom-url'].forEach(id =>
    document.getElementById(id)?.addEventListener('input', updateQRPreview)
  );

  document.getElementById('btn-apply-qr')?.addEventListener('click', () => {
    invoice.qrCode.enabled = true;
    invoice.qrCode.type = qrTab;
    invoice.qrCode.upiId = document.getElementById('qr-upi-id')?.value || '';
    invoice.qrCode.upiName = document.getElementById('qr-upi-name')?.value || '';
    invoice.qrCode.paypalUrl = document.getElementById('qr-paypal-url')?.value || '';
    invoice.qrCode.customUrl = document.getElementById('qr-custom-url')?.value || '';

    // Pre-fill the sidebar QR fields from current invoice
    const qrUpiId = document.getElementById('qr-upi-id');
    if (qrUpiId) qrUpiId.value = invoice.qrCode.upiId;

    renderAll();
    document.getElementById('payment-qr-modal')?.classList.add('hidden');
  });
  document.getElementById('btn-remove-qr')?.addEventListener('click', () => {
    invoice.qrCode.enabled = false;
    renderAll();
    document.getElementById('payment-qr-modal')?.classList.add('hidden');
  });
}

// ─── VAULT & MODALS ──────────────────────────────────────────────────────────

function renderHistoryList(q = '') {
  const container = document.getElementById('history-items-container');
  const summary = document.getElementById('history-total-summary');
  if (!container) return;
  const history = getInvoiceHistory();
  const filtered = q ? history.filter(h => h.invoiceNumber?.toLowerCase().includes(q.toLowerCase()) || h.clientName?.toLowerCase().includes(q.toLowerCase())) : history;
  if (summary) summary.textContent = `${history.length} invoices stored in your browser`;
  if (!filtered.length) { container.innerHTML = '<p class="text-center text-[#888888] text-xs py-8">No saved invoices found.</p>'; return; }

  container.innerHTML = filtered.map(h => `
    <div class="p-3.5 bg-[#fafafa] hover:bg-white rounded-xl border border-[#ebebeb] flex items-center justify-between gap-3">
      <div class="space-y-0.5 flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="font-bold text-xs font-mono text-[#171717] truncate">${escHtml(h.invoiceNumber)}</span>
          <span class="px-1.5 text-[10px] rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">${h.status || 'Draft'}</span>
        </div>
        <p class="text-xs text-[#4d4d4d] truncate">${escHtml(h.clientName)}</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="text-sm font-bold font-mono">${h.currencySymbol || '₹'}${Number(h.grandTotal).toFixed(2)}</span>
        <button data-load="${h.id}" class="btn-load px-2.5 py-1 text-xs font-medium text-white bg-[#171717] rounded-lg cursor-pointer">Load</button>
        <button data-dup="${h.id}" class="btn-dup px-2.5 py-1 text-xs font-medium text-[#171717] bg-[#f5f5f5] border border-[#ebebeb] rounded-lg cursor-pointer">Dupe</button>
        <button data-del="${h.id}" class="btn-del text-red-500 hover:text-red-700 font-bold p-1 cursor-pointer">×</button>
      </div>
    </div>
  `).join('');

  container.querySelectorAll('.btn-load').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    const target = history.find(h => h.id === btn.dataset.load);
    if (target?.fullData) { invoice = target.fullData; renderAll(); document.getElementById('invoice-history-modal')?.classList.add('hidden'); }
  }));
  container.querySelectorAll('.btn-dup').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    const dup = duplicateInvoiceInHistory(btn.dataset.dup);
    if (dup) { invoice = dup; renderAll(); renderHistoryList(q); alert(`Duplicated as "${dup.invoiceNumber}"`); }
  }));
  container.querySelectorAll('.btn-del').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    if (confirm('Delete this invoice?')) { deleteInvoiceFromHistory(btn.dataset.del); renderHistoryList(q); const badge = document.getElementById('history-count-badge'); if(badge) badge.textContent = getInvoiceHistory().length.toString(); }
  }));
}

function renderClientList() {
  const container = document.getElementById('client-book-list');
  if (!container) return;
  const clients = getClientsVault();
  if (!clients.length) { container.innerHTML = '<p class="text-center text-xs text-[#888888] py-8">No saved clients. Click "+ Save Current Client" above.</p>'; return; }
  container.innerHTML = clients.map(c => `
    <div class="p-3 bg-[#fafafa] hover:bg-white rounded-xl border border-[#ebebeb] flex items-start justify-between gap-3">
      <div class="flex-1 space-y-0.5 text-xs min-w-0">
        <p class="font-bold text-[#171717] truncate">${escHtml(c.name)}</p>
        ${c.taxId ? `<p class="font-mono text-[10px] text-[#888888]">GST: ${escHtml(c.taxId)}</p>` : ''}
        ${c.address ? `<p class="text-[11px] text-[#4d4d4d] whitespace-pre-line">${escHtml(c.address)}</p>` : ''}
      </div>
      <div class="flex gap-1.5 shrink-0">
        <button data-cid="${c.id}" class="btn-use-client px-2.5 py-1 text-xs font-medium text-white bg-[#171717] rounded-lg cursor-pointer">Use</button>
        <button data-del="${c.id}" class="btn-del-client text-red-500 font-bold p-1 cursor-pointer">×</button>
      </div>
    </div>
  `).join('');
  container.querySelectorAll('.btn-use-client').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    const target = clients.find(c => c.id === btn.dataset.cid);
    if (target) { Object.assign(invoice.client, target); renderAll(); document.getElementById('client-book-modal')?.classList.add('hidden'); }
  }));
  container.querySelectorAll('.btn-del-client').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    if (confirm('Delete client?')) { deleteClientFromVault(btn.dataset.del); renderClientList(); }
  }));
}

function renderCompanyList() {
  const container = document.getElementById('company-profiles-list');
  if (!container) return;
  const companies = getCompaniesVault();
  if (!companies.length) { container.innerHTML = '<p class="text-center text-xs text-[#888888] py-8">No saved company profiles yet.</p>'; return; }
  container.innerHTML = companies.map(c => `
    <div class="p-3 bg-[#fafafa] hover:bg-white rounded-xl border border-[#ebebeb] flex items-start justify-between gap-3">
      <div class="flex-1 space-y-0.5 text-xs min-w-0">
        <p class="font-bold text-[#171717] truncate">${escHtml(c.name)}</p>
        ${c.taxId ? `<p class="font-mono text-[10px] text-[#888888]">GST: ${escHtml(c.taxId)}</p>` : ''}
        ${c.address ? `<p class="text-[11px] text-[#4d4d4d] whitespace-pre-line">${escHtml(c.address)}</p>` : ''}
      </div>
      <div class="flex gap-1.5 shrink-0">
        <button data-cid="${c.id}" class="btn-use-comp px-2.5 py-1 text-xs font-medium text-white bg-[#171717] rounded-lg cursor-pointer">Select</button>
        <button data-del="${c.id}" class="btn-del-comp text-red-500 font-bold p-1 cursor-pointer">×</button>
      </div>
    </div>
  `).join('');
  container.querySelectorAll('.btn-use-comp').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    const target = companies.find(c => c.id === btn.dataset.cid);
    if (target) {
      Object.assign(invoice.sender, target);
      if (target.bankName) invoice.paymentDetails.bankName = target.bankName;
      if (target.accountNumber) invoice.paymentDetails.accountNumber = target.accountNumber;
      if (target.ifsc) invoice.paymentDetails.swift = target.ifsc;
      renderAll();
      document.getElementById('company-manager-modal')?.classList.add('hidden');
    }
  }));
  container.querySelectorAll('.btn-del-comp').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    if (confirm('Delete company profile?')) { deleteCompanyFromVault(btn.dataset.del); renderCompanyList(); }
  }));
}

function renderCatalogList() {
  const container = document.getElementById('catalog-items-list');
  if (!container) return;
  const catalog = getItemsCatalog();
  const sym = invoice.currency?.symbol || '₹';
  if (!catalog.length) { container.innerHTML = '<p class="text-center text-xs text-[#888888] py-8">No catalog items yet. Add one above.</p>'; return; }
  container.innerHTML = catalog.map(item => `
    <div class="p-3 bg-[#fafafa] hover:bg-white rounded-xl border border-[#ebebeb] flex items-center justify-between gap-3">
      <div class="flex-1 min-w-0">
        <p class="font-bold text-xs text-[#171717] truncate">${escHtml(item.description)}</p>
        <p class="text-[10px] font-mono text-[#888888]">HSN: ${item.hsn || '-'} · ${item.unit || 'No'}</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="font-mono font-bold text-sm">${sym}${Number(item.rate).toFixed(2)}</span>
        <button data-iid="${item.id}" class="btn-add-cat px-2.5 py-1 text-xs font-medium text-white bg-[#171717] rounded-lg cursor-pointer">+ Add</button>
        <button data-del="${item.id}" class="btn-del-cat text-red-500 font-bold p-1 cursor-pointer">×</button>
      </div>
    </div>
  `).join('');
  container.querySelectorAll('.btn-add-cat').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    const target = catalog.find(i => i.id === btn.dataset.iid);
    if (target) {
      invoice.items.push({ id: 'i'+Date.now(), description: target.description, hsn: target.hsn||'', unit: target.unit||'No', quantity: 1, rate: target.rate||0, discount: 0, discountType: 'percent', taxRate: target.taxRate||18 });
      renderAll();
      document.getElementById('item-catalog-modal')?.classList.add('hidden');
    }
  }));
  container.querySelectorAll('.btn-del-cat').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    if (confirm('Delete item from catalog?')) { deleteItemFromCatalog(btn.dataset.del); renderCatalogList(); }
  }));
}

// ─── HELPERS ─────────────────────────────────────────────────────────────────

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// Start
if (typeof window !== 'undefined') {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
}
</script>
