        <div class="flex items-center gap-3 shrink-0">
          <span class="text-xs font-bold font-mono text-[#171717]">${currSymbol}${Number(item.rate).toFixed(2)}</span>
          <button type="button" data-catalog-id="${item.id}" class="btn-insert-catalog-item px-3 py-1 text-xs font-medium text-white bg-[#171717] hover:bg-black rounded-lg transition-all cursor-pointer">
            + Add
          </button>
          <button type="button" data-del-catalog-id="${item.id}" class="btn-del-catalog-item p-1 text-[#888888] hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors cursor-pointer" title="Delete item">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.btn-insert-catalog-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const itemId = (btn as HTMLElement).dataset.catalogId;
        const target = catalog.find((i: any) => i.id === itemId);
        if (target) {
          invoice.items.push({
            id: 'item_' + Date.now(),
            description: target.description,
            hsn: target.hsn || '',
            unit: target.unit || 'Qty',
            quantity: 1,
            rate: target.rate || 0,
            discount: 0,
            discountType: 'percent',
            taxRate: target.taxRate || 0
          });
          renderInvoice();
          document.getElementById('item-catalog-modal')?.classList.add('hidden');
        }
      });
    });

    container.querySelectorAll('.btn-del-catalog-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const itemId = (btn as HTMLElement).dataset.delCatalogId;
        if (itemId && confirm('Delete this item from catalog?')) {
          deleteItemFromCatalog(itemId);
          renderCatalogItemsList();
        }
      });
    });
  }

  function bindCompanyAndCatalogEvents() {
    // Save current sender details as company profile (Requirement 1)
    document.getElementById('btn-save-current-as-company')?.addEventListener('click', (e) => {
      e.preventDefault();
      const compName = document.getElementById('inv-sender-name')?.textContent?.trim() || '';
      const compAddress = document.getElementById('inv-sender-address')?.textContent?.trim() || '';
      const compEmail = document.getElementById('inv-sender-email')?.textContent?.trim() || '';
      const compPhone = document.getElementById('inv-sender-phone')?.textContent?.trim() || '';
      const compTaxId = document.getElementById('inv-sender-taxid')?.textContent?.trim() || '';
      const bankName = document.getElementById('bank-name')?.textContent?.trim() || '';
      const bankHolder = document.getElementById('bank-holder')?.textContent?.trim() || '';
      const bankAcc = document.getElementById('bank-account')?.textContent?.trim() || '';
      const bankIfsc = document.getElementById('bank-ifsc')?.textContent?.trim() || '';

      if (compName) {
        saveCompanyToVault({
          name: compName,
          address: compAddress,
          email: compEmail,
          phone: compPhone,
          taxId: compTaxId,
          logo: invoice.sender?.logo || '',
          bankName,
          accountName: bankHolder,
          accountNumber: bankAcc,
          ifsc: bankIfsc
        });
        renderCompanyList();
        alert(`Company profile "${compName}" saved! You can switch back to it anytime.`);
      } else {
        alert('Please enter a company name on the invoice first.');
      }
    });

    // Save new item to catalog (Requirement 3)
    document.getElementById('btn-save-new-catalog-item')?.addEventListener('click', (e) => {
      e.preventDefault();
      const desc = (document.getElementById('catalog-desc-input') as HTMLInputElement)?.value?.trim();
      const hsn = (document.getElementById('catalog-hsn-input') as HTMLInputElement)?.value?.trim();
      const unit = (document.getElementById('catalog-unit-input') as HTMLInputElement)?.value?.trim();
      const rate = parseFloat((document.getElementById('catalog-rate-input') as HTMLInputElement)?.value) || 0;

      if (desc) {
        saveItemToCatalog({ description: desc, hsn, unit, rate });
        renderCatalogItemsList();
        (document.getElementById('catalog-desc-input') as HTMLInputElement).value = '';
        (document.getElementById('catalog-hsn-input') as HTMLInputElement).value = '';
        (document.getElementById('catalog-unit-input') as HTMLInputElement).value = '';
        (document.getElementById('catalog-rate-input') as HTMLInputElement).value = '';
        alert('New item added to your catalog!');
      } else {
        alert('Please enter an item description.');
      }
    });
  }

  // Run on initial page load strictly once
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  }
</script>
