---
// InvoiceEditor.astro - Master Container connecting Sidebar, Canvas, and Studio Modals
import SidebarControls from './editor/SidebarControls.astro';
import Canvas from './editor/Canvas.astro';
import SignatureModal from './editor/SignatureModal.astro';
import PaymentQrModal from './editor/PaymentQrModal.astro';
import InvoiceHistoryModal from './editor/InvoiceHistoryModal.astro';
import ClientBookModal from './editor/ClientBookModal.astro';
import CompanyManagerModal from './editor/CompanyManagerModal.astro';
import ItemCatalogModal from './editor/ItemCatalogModal.astro';
---

<section id="generator-section" class="py-8 md:py-12 px-3 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <!-- Section Title -->
  <div class="mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2 py-0.5 text-[10px] font-mono font-medium uppercase tracking-wider bg-black text-white rounded">Live Studio</span>
        <span class="text-xs text-[#888888]">Click on any invoice field to edit in real time</span>
      </div>
      <h2 class="text-2xl font-bold tracking-tight text-[#171717]">Interactive Invoice Generator</h2>
    </div>

    <!-- Quick Tool Pills -->
    <div class="flex items-center gap-2 flex-wrap">
      <button id="quick-btn-companies" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
        <span>My Companies</span>
      </button>

      <button id="quick-btn-items" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
        <span>Item Catalog</span>
      </button>

      <button id="quick-btn-clients" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        <span>Address Book</span>
      </button>

      <button id="quick-btn-sig" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
        <span>Signature Pad</span>
      </button>

      <button id="quick-btn-qr" type="button" class="px-3 py-1.5 text-xs font-medium bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>
        <span>Payment QR</span>
      </button>
    </div>
  </div>

  <!-- Dual Column Layout: Canvas + Control Sidebar -->
  <div class="flex flex-col lg:flex-row items-start gap-8">
    <!-- Center / Left: WYSIWYG Sheet -->
    <Canvas />

    <!-- Right: Sidebar Controller -->
    <SidebarControls />
  </div>

  <!-- Studio Modals -->
  <SignatureModal />
  <PaymentQrModal />
  <InvoiceHistoryModal />
  <ClientBookModal />
  <CompanyManagerModal />
  <ItemCatalogModal />
</section>

<!-- Client Script: Reactive State Management & PDF / QR / Signature Engine -->
<script>
  import {
    getDefaultInvoice,
    calculateTotals,
    saveCurrentInvoiceToStorage,
    loadCurrentInvoiceFromStorage,
    getInvoiceHistory,
    saveInvoiceToHistory,
    deleteInvoiceFromHistory,
    getClientsVault,
    saveClientToVault,
    deleteClientFromVault,
    getCompaniesVault,
    saveCompanyToVault,
    deleteCompanyFromVault,
    getItemsCatalog,
    saveItemToCatalog,
    deleteItemFromCatalog,
    CURRENCIES,
    DOCUMENT_TYPES
  } from '../scripts/invoice-state.js';
  import { generatePaymentQRCode } from '../scripts/qr-generator.js';
  import { exportInvoiceToPDF, exportInvoiceToPNG, generateWhatsAppShareLink, generateEmailShareLink } from '../scripts/pdf-generator.js';
  import confetti from 'canvas-confetti';

  // Global Reactive State
  let invoice = loadCurrentInvoiceFromStorage();
  let signaturePadDrawing = false;
  let signatureUndoStack = [];
  let currentSigColor = '#171717';
  let currentSigTab = 'draw';
  let currentQrTab = 'upi';
  let isInitialized = false;

  // DOM Elements References
  const paper = document.getElementById('invoice-paper');
  const itemsBody = document.getElementById('inv-items-body');
  const historyBadge = document.getElementById('history-count-badge');

  // Initialize UI & Bind Events strictly once
  function init() {
    if (isInitialized) return;
    isInitialized = true;

    renderInvoice();
    updateHistoryCount();
    bindEvents();
    initSignatureCanvas();
    updateQRPreview();
  }

  // Render complete invoice state to canvas and controls
  function renderInvoice() {
    const totals = calculateTotals(invoice);

    // 1. Doc Title & Number
    const docTitleEl = document.getElementById('inv-doc-title');
    if (docTitleEl) docTitleEl.textContent = invoice.docTitle || 'TAX INVOICE';
    
    const invNumEl = document.getElementById('inv-number');
    if (invNumEl) invNumEl.textContent = invoice.invoiceNumber;

    const issueDateEl = document.getElementById('inv-issue-date') as HTMLInputElement;
    if (issueDateEl) issueDateEl.value = invoice.issueDate;

    const dueDateEl = document.getElementById('inv-due-date') as HTMLInputElement;
    if (dueDateEl) dueDateEl.value = invoice.dueDate;

    const poEl = document.getElementById('inv-po-number') as HTMLInputElement;
    if (poEl) poEl.value = invoice.referenceNumber || '';

    // 2. Sender Info
    const senderNameEl = document.getElementById('inv-sender-name');
    if (senderNameEl) senderNameEl.textContent = invoice.sender?.name || '';

    const senderAddrEl = document.getElementById('inv-sender-address');
    if (senderAddrEl) senderAddrEl.textContent = invoice.sender?.address || '';

    const senderEmailEl = document.getElementById('inv-sender-email');
    if (senderEmailEl) senderEmailEl.textContent = invoice.sender?.email || '';

    const senderPhoneEl = document.getElementById('inv-sender-phone');
    if (senderPhoneEl) senderPhoneEl.textContent = invoice.sender?.phone || '';

    const senderTaxEl = document.getElementById('inv-sender-taxid');
    if (senderTaxEl) senderTaxEl.textContent = invoice.sender?.taxId || '';

    // Logo
    const logoImg = document.getElementById('sender-logo-img') as HTMLImageElement;
    const logoPlh = document.getElementById('logo-placeholder');
    const btnRemoveLogo = document.getElementById('btn-remove-logo');
    if (invoice.sender?.logo) {
      if (logoImg) {
        logoImg.src = invoice.sender.logo;
        logoImg.classList.remove('hidden');
      }
      if (logoPlh) logoPlh.classList.add('hidden');
      if (btnRemoveLogo) btnRemoveLogo.classList.remove('hidden');
    } else {
      if (logoImg) logoImg.classList.add('hidden');
      if (logoPlh) logoPlh.classList.remove('hidden');
      if (btnRemoveLogo) btnRemoveLogo.classList.add('hidden');
    }

    // 3. Client Info
    const clientNameEl = document.getElementById('inv-client-name');
    if (clientNameEl) clientNameEl.textContent = invoice.client?.name || '';

    const clientAddrEl = document.getElementById('inv-client-address');
    if (clientAddrEl) clientAddrEl.textContent = invoice.client?.address || '';

    const clientEmailEl = document.getElementById('inv-client-email');
    if (clientEmailEl) clientEmailEl.textContent = invoice.client?.email || '';

    const clientPhoneEl = document.getElementById('inv-client-phone');
    if (clientPhoneEl) clientPhoneEl.textContent = invoice.client?.phone || '';

    const clientTaxEl = document.getElementById('inv-client-taxid');
    if (clientTaxEl) clientTaxEl.textContent = invoice.client?.taxId || '';

    // 4. Line Items Table
    renderLineItems();

    // 5. Totals & Summaries
    const currSymbol = invoice.currency?.symbol || '$';
    const subtotalEl = document.getElementById('sum-subtotal');
    if (subtotalEl) subtotalEl.textContent = `${currSymbol}${totals.subtotal.toFixed(2)}`;

    // Line Discount row
    const rowLineDisc = document.getElementById('sum-row-linedisc');
    const sumLineDisc = document.getElementById('sum-linedisc');
    if (totals.totalLineDiscount > 0) {
      rowLineDisc?.classList.remove('hidden');
      rowLineDisc?.classList.add('flex');
      if (sumLineDisc) sumLineDisc.textContent = `-${currSymbol}${totals.totalLineDiscount.toFixed(2)}`;
    } else {
      rowLineDisc?.classList.add('hidden');
      rowLineDisc?.classList.remove('flex');
    }

    // Invoice Discount row
    const rowInvDisc = document.getElementById('sum-row-invdisc');
    const sumInvDisc = document.getElementById('sum-invdisc');
    const sumInvDiscLabel = document.getElementById('sum-invdisc-label');
    if (totals.invoiceDiscount > 0) {
      rowInvDisc?.classList.remove('hidden');
      rowInvDisc?.classList.add('flex');
      if (sumInvDiscLabel) sumInvDiscLabel.textContent = `Discount (${invoice.discountType === 'percent' ? invoice.discountValue + '%' : currSymbol + invoice.discountValue})`;
      if (sumInvDisc) sumInvDisc.textContent = `-${currSymbol}${totals.invoiceDiscount.toFixed(2)}`;
    } else {
      rowInvDisc?.classList.add('hidden');
      rowInvDisc?.classList.remove('flex');
    }

    // Tax rows
    const rowTax = document.getElementById('sum-row-tax');
    const rowCGST = document.getElementById('sum-row-cgst');
    const rowSGST = document.getElementById('sum-row-sgst');
    const rowIGST = document.getElementById('sum-row-igst');

    if (invoice.taxMode === 'gst') {
      rowTax?.classList.add('hidden');
      if (invoice.isInterstateGST) {
        rowCGST?.classList.add('hidden');
        rowSGST?.classList.add('hidden');
        rowIGST?.classList.remove('hidden');
        rowIGST?.classList.add('flex');
        const sumIgst = document.getElementById('sum-igst');
        const sumIgstLabel = document.getElementById('sum-igst-label');
        if (sumIgst) sumIgst.textContent = `${currSymbol}${totals.igstAmount.toFixed(2)}`;
        if (sumIgstLabel) sumIgstLabel.textContent = `IGST (${invoice.igstRate}%)`;
      } else {
        rowIGST?.classList.add('hidden');
        rowCGST?.classList.remove('hidden');
        rowCGST?.classList.add('flex');
        rowSGST?.classList.remove('hidden');
        rowSGST?.classList.add('flex');
        const sumCgst = document.getElementById('sum-cgst');
        const sumCgstLabel = document.getElementById('sum-cgst-label');
        if (sumCgst) sumCgst.textContent = `${currSymbol}${totals.cgstAmount.toFixed(2)}`;
        if (sumCgstLabel) sumCgstLabel.textContent = `CGST (${invoice.cgstRate}%)`;

        const sumSgst = document.getElementById('sum-sgst');
        const sumSgstLabel = document.getElementById('sum-sgst-label');
        if (sumSgst) sumSgst.textContent = `${currSymbol}${totals.sgstAmount.toFixed(2)}`;
        if (sumSgstLabel) sumSgstLabel.textContent = `SGST (${invoice.sgstRate}%)`;
      }
    } else if (invoice.taxMode === 'none') {
      rowTax?.classList.add('hidden');
      rowCGST?.classList.add('hidden');
      rowSGST?.classList.add('hidden');
      rowIGST?.classList.add('hidden');
    } else {
      // Single tax or VAT
      rowCGST?.classList.add('hidden');
      rowSGST?.classList.add('hidden');
      rowIGST?.classList.add('hidden');
      rowTax?.classList.remove('hidden');
      rowTax?.classList.add('flex');
      const sumTax = document.getElementById('sum-tax');
      const sumTaxLabel = document.getElementById('sum-tax-label');
      if (sumTax) sumTax.textContent = `${currSymbol}${totals.taxAmount.toFixed(2)}`;
      if (sumTaxLabel) sumTaxLabel.textContent = `Tax (${invoice.taxRate}%)`;
    }

    // Shipping row
    const rowShipping = document.getElementById('sum-row-shipping');
    const sumShipping = document.getElementById('sum-shipping');
    if (totals.shipping > 0) {
      rowShipping?.classList.remove('hidden');
      rowShipping?.classList.add('flex');
      if (sumShipping) sumShipping.textContent = `${currSymbol}${totals.shipping.toFixed(2)}`;
    } else {
      rowShipping?.classList.add('hidden');
      rowShipping?.classList.remove('flex');
    }

    // Roundoff row
    const rowRoundoff = document.getElementById('sum-row-roundoff');
    const sumRoundoff = document.getElementById('sum-roundoff');
    if (invoice.roundOff && totals.roundOffAdjustment !== 0) {
      rowRoundoff?.classList.remove('hidden');
      rowRoundoff?.classList.add('flex');
      if (sumRoundoff) sumRoundoff.textContent = `${totals.roundOffAdjustment > 0 ? '+' : ''}${currSymbol}${totals.roundOffAdjustment.toFixed(2)}`;
    } else {
      rowRoundoff?.classList.add('hidden');
      rowRoundoff?.classList.remove('flex');
    }

    // Grand Total & Words
    const sumGrand = document.getElementById('sum-grandtotal');
    if (sumGrand) sumGrand.textContent = `${currSymbol}${totals.grandTotal.toFixed(2)}`;

    const wordsEl = document.getElementById('inv-amount-words');
    if (wordsEl) wordsEl.textContent = totals.amountInWords;

    // Bank Details
    const bankName = document.getElementById('bank-name');
    if (bankName) bankName.textContent = invoice.paymentDetails?.bankName || '';
    const bankHolder = document.getElementById('bank-holder');
    if (bankHolder) bankHolder.textContent = invoice.paymentDetails?.accountName || '';
    const bankAcc = document.getElementById('bank-account');
    if (bankAcc) bankAcc.textContent = invoice.paymentDetails?.accountNumber || '';
    const bankIfsc = document.getElementById('bank-ifsc');
    if (bankIfsc) bankIfsc.textContent = invoice.paymentDetails?.swift || invoice.paymentDetails?.routingNumber || '';

    // Terms & Notes
    const termsEl = document.getElementById('inv-terms');
    if (termsEl) termsEl.textContent = invoice.terms || '';
    const notesEl = document.getElementById('inv-notes');
    if (notesEl) notesEl.textContent = invoice.notes || '';

    // 6. Signature display
    renderSignature();

    // 7. QR Code display
    renderQRCode(totals.grandTotal);

    // 8. Column Visibility
    toggleColumnVisibility();

    // 9. Theme and Color Styling
    applyThemeStyling();

    // 10. Sync Sidebar Form Controls
    syncSidebarInputs();

    // Save to LocalStorage
    saveCurrentInvoiceToStorage(invoice);
  }

  // Render line items in the table
  function renderLineItems() {
    if (!itemsBody) return;
    itemsBody.innerHTML = '';
    const currSymbol = invoice.currency?.symbol || '$';

    invoice.items.forEach((item: any, index: number) => {
      const tr = document.createElement('tr');
      tr.className = 'group hover:bg-[#fafafa] transition-colors';
      tr.dataset.index = index.toString();

      const qty = Number(item.quantity) || 0;
      const rate = Number(item.rate) || 0;
      let lineTotal = qty * rate;
      if (invoice.columns?.discount && item.discount) {
        const disc = Number(item.discount);
        lineTotal -= item.discountType === 'fixed' ? disc : (lineTotal * disc) / 100;
      }

      tr.innerHTML = `
        <td class="py-3 px-3 text-center text-[#888888] font-mono text-xs">${index + 1}</td>
        <td class="py-3 px-3">
          <div class="item-desc font-medium text-[#171717] outline-hidden whitespace-pre-line" contenteditable="true" placeholder="Item name or service description...">${item.description || ''}</div>
        </td>
        <td class="py-3 px-2 text-center col-hsn ${invoice.columns?.hsn ? '' : 'hidden'}">
          <input type="text" value="${item.hsn || ''}" placeholder="HSN" class="item-hsn w-full text-center text-xs font-mono bg-transparent outline-hidden border border-transparent focus:border-[#171717] rounded px-1" />
        </td>
        <td class="py-3 px-2 text-center col-unit ${invoice.columns?.unit ? '' : 'hidden'}">
          <input type="text" value="${item.unit || 'Hours'}" placeholder="Unit" class="item-unit w-full text-center text-xs bg-transparent outline-hidden border border-transparent focus:border-[#171717] rounded px-1" />
        </td>
        <td class="py-3 px-3 text-right">
          <input type="number" min="0" step="any" value="${item.quantity}" class="item-qty w-16 text-right text-xs font-mono font-medium bg-transparent outline-hidden border border-transparent focus:border-[#171717] rounded px-1 py-0.5" />
        </td>
        <td class="py-3 px-3 text-right">
          <input type="number" min="0" step="any" value="${item.rate}" class="item-rate w-24 text-right text-xs font-mono font-medium bg-transparent outline-hidden border border-transparent focus:border-[#171717] rounded px-1 py-0.5" />
        </td>
        <td class="py-3 px-2 text-right col-discount ${invoice.columns?.discount ? '' : 'hidden'}">
          <input type="number" min="0" step="any" value="${item.discount || 0}" class="item-discount w-14 text-right text-xs font-mono bg-transparent outline-hidden border border-transparent focus:border-[#171717] rounded px-1 py-0.5" />
        </td>
        <td class="py-3 px-3 text-right font-mono font-semibold text-[#171717]">
          ${currSymbol}${Math.max(0, lineTotal).toFixed(2)}
        </td>
        <td class="py-3 px-2 text-center no-print">
          <button type="button" class="btn-delete-row text-[#888888] hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity p-1 cursor-pointer" title="Delete line item">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        </td>
      `;

      // Item Input Event Listeners
      const descEl = tr.querySelector('.item-desc');
      const hsnEl = tr.querySelector('.item-hsn') as HTMLInputElement;
      const unitEl = tr.querySelector('.item-unit') as HTMLInputElement;
      const qtyEl = tr.querySelector('.item-qty') as HTMLInputElement;
      const rateEl = tr.querySelector('.item-rate') as HTMLInputElement;
      const discEl = tr.querySelector('.item-discount') as HTMLInputElement;
      const delBtn = tr.querySelector('.btn-delete-row');

      descEl?.addEventListener('blur', () => {
        invoice.items[index].description = descEl.textContent || '';
        saveCurrentInvoiceToStorage(invoice);
      });

      hsnEl?.addEventListener('input', () => {
        invoice.items[index].hsn = hsnEl.value;
        saveCurrentInvoiceToStorage(invoice);
      });

      unitEl?.addEventListener('input', () => {
        invoice.items[index].unit = unitEl.value;
        saveCurrentInvoiceToStorage(invoice);
      });

      qtyEl?.addEventListener('input', () => {
        invoice.items[index].quantity = parseFloat(qtyEl.value) || 0;
        renderInvoice();
      });

      rateEl?.addEventListener('input', () => {
        invoice.items[index].rate = parseFloat(rateEl.value) || 0;
        renderInvoice();
      });

      discEl?.addEventListener('input', () => {
        invoice.items[index].discount = parseFloat(discEl.value) || 0;
        renderInvoice();
      });

      delBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (invoice.items.length > 1) {
          invoice.items.splice(index, 1);
          renderInvoice();
        } else {
          alert('An invoice must have at least one line item.');
        }
      });

      itemsBody.appendChild(tr);
    });
  }

  // Render Signature Stamp
  function renderSignature() {
    const sigSec = document.getElementById('inv-sig-section');
    const sigImg = document.getElementById('sig-display-img') as HTMLImageElement;
    const sigText = document.getElementById('sig-display-text');
    const sigName = document.getElementById('inv-sig-name');
    const sigTitle = document.getElementById('inv-sig-title');
    const statusBadge = document.getElementById('sig-status-badge');

    if (!invoice.signature?.enabled) {
      if (sigSec) sigSec.classList.add('opacity-40');
      if (statusBadge) statusBadge.textContent = 'Disabled';
      return;
    }

    if (sigSec) sigSec.classList.remove('opacity-40');
    if (statusBadge) statusBadge.textContent = 'Active';

    if (sigName) sigName.textContent = invoice.signature.typedName || 'Alex Morgan';
    if (sigTitle) sigTitle.textContent = invoice.signature.title || 'Authorized Signatory';

    if (invoice.signature.type === 'draw' || invoice.signature.type === 'upload') {
      if (invoice.signature.dataUrl && sigImg) {
        sigImg.src = invoice.signature.dataUrl;
        sigImg.classList.remove('hidden');
      }
      if (sigText) sigText.classList.add('hidden');
    } else {
      if (sigImg) sigImg.classList.add('hidden');
      if (sigText) {
        sigText.classList.remove('hidden');
        sigText.textContent = invoice.signature.typedName || 'Alex Morgan';
        sigText.style.fontFamily = `'${invoice.signature.fontFamily || 'Caveat'}', cursive`;
      }
    }
  }

  // Render Payment QR Code
  async function renderQRCode(grandTotal: number) {
    const qrSection = document.getElementById('inv-qr-section');
    const qrImg = document.getElementById('inv-qr-img') as HTMLImageElement;
    const qrDesc = document.getElementById('inv-qr-desc');
    const statusBadge = document.getElementById('qr-status-badge');

    if (!invoice.qrCode?.enabled) {
      if (qrSection) qrSection.classList.add('hidden');
      if (statusBadge) statusBadge.textContent = 'Disabled';
      return;
    }

    if (qrSection) qrSection.classList.remove('hidden');
    if (statusBadge) statusBadge.textContent = 'Active';

    const qrResult = await generatePaymentQRCode(invoice.qrCode, grandTotal, invoice.currency?.code, invoice.invoiceNumber);
    if (qrResult?.dataUrl && qrImg) {
      qrImg.src = qrResult.dataUrl;
      invoice.qrCode.qrDataUrl = qrResult.dataUrl;
    }

    if (qrDesc) {
      if (invoice.qrCode.type === 'upi') {
        qrDesc.textContent = `UPI: ${invoice.qrCode.upiId || 'acme@upi'}`;
      } else if (invoice.qrCode.type === 'paypal') {
        qrDesc.textContent = `PayPal Checkout`;
      } else if (invoice.qrCode.type === 'sepa') {
        qrDesc.textContent = `SEPA Instant Transfer`;
      } else {
        qrDesc.textContent = `Scan to Pay`;
      }
    }
