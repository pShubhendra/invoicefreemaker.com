  // Signature Studio Canvas & Tabs
  function initSignatureCanvas() {
    const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = currentSigColor;

    const startDraw = (e: MouseEvent | TouchEvent) => {
      signaturePadDrawing = true;
      const rect = canvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      ctx.beginPath();
      ctx.moveTo(clientX - rect.left, clientY - rect.top);
    };

    const draw = (e: MouseEvent | TouchEvent) => {
      if (!signaturePadDrawing) return;
      const rect = canvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      ctx.lineTo(clientX - rect.left, clientY - rect.top);
      ctx.stroke();
    };

    const stopDraw = () => {
      if (signaturePadDrawing) {
        signaturePadDrawing = false;
        signatureUndoStack.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
      }
    };

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDraw);
    canvas.addEventListener('mouseleave', stopDraw);

    canvas.addEventListener('touchstart', (e) => { e.preventDefault(); startDraw(e); }, { passive: false });
    canvas.addEventListener('touchmove', (e) => { e.preventDefault(); draw(e); }, { passive: false });
    canvas.addEventListener('touchend', (e) => { e.preventDefault(); stopDraw(); }, { passive: false });
  }

  function bindSignatureStudioEvents() {
    const tabDraw = document.getElementById('sig-tab-draw');
    const tabType = document.getElementById('sig-tab-type');
    const tabUpload = document.getElementById('sig-tab-upload');

    const contentDraw = document.getElementById('sig-content-draw');
    const contentType = document.getElementById('sig-content-type');
    const contentUpload = document.getElementById('sig-content-upload');

    const setSigTab = (tab: 'draw' | 'type' | 'upload') => {
      currentSigTab = tab;
      [tabDraw, tabType, tabUpload].forEach(t => {
        t?.classList.remove('bg-white', 'text-[#171717]', 'shadow-xs');
        t?.classList.add('text-[#4d4d4d]');
      });
      [contentDraw, contentType, contentUpload].forEach(c => c?.classList.add('hidden'));

      if (tab === 'draw') {
        tabDraw?.classList.add('bg-white', 'text-[#171717]', 'shadow-xs');
        contentDraw?.classList.remove('hidden');
      } else if (tab === 'type') {
        tabType?.classList.add('bg-white', 'text-[#171717]', 'shadow-xs');
        contentType?.classList.remove('hidden');
      } else {
        tabUpload?.classList.add('bg-white', 'text-[#171717]', 'shadow-xs');
        contentUpload?.classList.remove('hidden');
      }
    };

    tabDraw?.addEventListener('click', () => setSigTab('draw'));
    tabType?.addEventListener('click', () => setSigTab('type'));
    tabUpload?.addEventListener('click', () => setSigTab('upload'));

    // Color pickers in draw tab
    document.querySelectorAll('.sig-color-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const col = (btn as HTMLElement).dataset.color || '#171717';
        currentSigColor = col;
        const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
        const ctx = canvas?.getContext('2d');
        if (ctx) ctx.strokeStyle = col;
        document.querySelectorAll('.sig-color-btn').forEach(b => b.classList.remove('ring-2', 'ring-offset-1', 'ring-[#171717]'));
        btn.classList.add('ring-2', 'ring-offset-1', 'ring-[#171717]');
      });
    });

    // Clear & Undo
    document.getElementById('btn-clear-sig')?.addEventListener('click', () => {
      const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');
      if (ctx && canvas) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        signatureUndoStack = [];
      }
    });

    document.getElementById('btn-undo-sig')?.addEventListener('click', () => {
      const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
      const ctx = canvas?.getContext('2d');
      if (ctx && canvas && signatureUndoStack.length > 0) {
        signatureUndoStack.pop();
        if (signatureUndoStack.length > 0) {
          ctx.putImageData(signatureUndoStack[signatureUndoStack.length - 1], 0, 0);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
    });

    // Type signature live previews
    const typedInput = document.getElementById('sig-typed-input') as HTMLInputElement;
    typedInput?.addEventListener('input', () => {
      const name = typedInput.value || 'Alex Morgan';
      ['preview-font-1', 'preview-font-2', 'preview-font-3', 'preview-font-4'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = name;
      });
    });

    // Radio selection cards
    document.querySelectorAll('.sig-font-card').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.sig-font-card').forEach(c => c.classList.remove('ring-2', 'ring-[#171717]'));
        card.classList.add('ring-2', 'ring-[#171717]');
        const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio) radio.checked = true;
      });
    });

    // Signature upload file input
    const sigFileInput = document.getElementById('sig-file-input') as HTMLInputElement;
    const sigUploadPreviewWrap = document.getElementById('sig-upload-preview-wrap');
    const sigUploadPreview = document.getElementById('sig-upload-preview') as HTMLImageElement;

    sigFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          const dataUrl = evt.target?.result as string;
          if (sigUploadPreview) sigUploadPreview.src = dataUrl;
          sigUploadPreviewWrap?.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      }
    });

    // Apply Signature Button
    document.getElementById('btn-apply-sig')?.addEventListener('click', () => {
      const signerName = (document.getElementById('sig-signer-name') as HTMLInputElement)?.value || 'Alex Morgan';
      const signerTitle = (document.getElementById('sig-signer-title') as HTMLInputElement)?.value || 'Authorized Signatory';

      invoice.signature.enabled = true;
      invoice.signature.typedName = signerName;
      invoice.signature.title = signerTitle;

      if (currentSigTab === 'draw') {
        const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
        invoice.signature.type = 'draw';
        invoice.signature.dataUrl = canvas ? canvas.toDataURL('image/png') : '';
      } else if (currentSigTab === 'type') {
        invoice.signature.type = 'type';
        const selectedFont = (document.querySelector('input[name="sig-font-choice"]:checked') as HTMLInputElement)?.value || 'Caveat';
        invoice.signature.fontFamily = selectedFont;
        invoice.signature.typedName = typedInput?.value || signerName;
      } else {
        invoice.signature.type = 'upload';
        invoice.signature.dataUrl = sigUploadPreview?.src || '';
      }

      renderInvoice();
      document.getElementById('signature-modal')?.classList.add('hidden');
    });

    // Remove Signature Button
    document.getElementById('btn-remove-sig-from-inv')?.addEventListener('click', () => {
      invoice.signature.enabled = false;
      renderInvoice();
      document.getElementById('signature-modal')?.classList.add('hidden');
    });
  }

  // Payment QR Modal Tab & Preview
  async function updateQRPreview() {
    const upiId = (document.getElementById('qr-upi-id') as HTMLInputElement)?.value || 'acme@upi';
    const upiName = (document.getElementById('qr-upi-name') as HTMLInputElement)?.value || 'Acme Design';
    const paypalUrl = (document.getElementById('qr-paypal-url') as HTMLInputElement)?.value || 'https://paypal.me/acmedesign';
    const customUrl = (document.getElementById('qr-custom-url') as HTMLInputElement)?.value || 'https://invoicefreemaker.com/pay';

    const tempConfig = {
      enabled: true,
      type: currentQrTab,
      upiId,
      upiName,
      paypalUrl,
      customUrl
    };

    const qrResult = await generatePaymentQRCode(tempConfig, 100, 'USD', 'INV-PREVIEW');
    const previewImg = document.getElementById('qr-preview-img') as HTMLImageElement;
    const placeholder = document.getElementById('qr-preview-placeholder');

    if (qrResult?.dataUrl && previewImg) {
      previewImg.src = qrResult.dataUrl;
      previewImg.classList.remove('hidden');
      placeholder?.classList.add('hidden');
    }
  }

  function bindQRModalEvents() {
    const tabs = ['upi', 'paypal', 'sepa', 'custom'];
    tabs.forEach(tab => {
      document.getElementById(`qr-tab-${tab}`)?.addEventListener('click', () => {
        currentQrTab = tab;
        tabs.forEach(t => {
          const btn = document.getElementById(`qr-tab-${t}`);
          const content = document.getElementById(`qr-content-${t}`);
          if (t === tab) {
            btn?.classList.add('bg-white', 'text-[#171717]', 'shadow-xs');
            btn?.classList.remove('text-[#4d4d4d]');
            content?.classList.remove('hidden');
          } else {
            btn?.classList.remove('bg-white', 'text-[#171717]', 'shadow-xs');
            btn?.classList.add('text-[#4d4d4d]');
            content?.classList.add('hidden');
          }
        });
        updateQRPreview();
      });
    });

    ['qr-upi-id', 'qr-upi-name', 'qr-paypal-url', 'qr-sepa-iban', 'qr-custom-url'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateQRPreview);
    });

    document.getElementById('btn-apply-qr')?.addEventListener('click', () => {
      invoice.qrCode.enabled = true;
      invoice.qrCode.type = currentQrTab;
      invoice.qrCode.upiId = (document.getElementById('qr-upi-id') as HTMLInputElement)?.value || '';
      invoice.qrCode.upiName = (document.getElementById('qr-upi-name') as HTMLInputElement)?.value || '';
      invoice.qrCode.paypalUrl = (document.getElementById('qr-paypal-url') as HTMLInputElement)?.value || '';
      invoice.qrCode.customUrl = (document.getElementById('qr-custom-url') as HTMLInputElement)?.value || '';

      renderInvoice();
      document.getElementById('payment-qr-modal')?.classList.add('hidden');
    });

    document.getElementById('btn-remove-qr')?.addEventListener('click', () => {
      invoice.qrCode.enabled = false;
      renderInvoice();
      document.getElementById('payment-qr-modal')?.classList.add('hidden');
    });
  }

