---
// Hero.astro - Hero section with atmospheric mesh gradient and value proposition
---

<section class="relative pt-12 pb-16 md:pt-16 md:pb-20 overflow-hidden border-b border-[#ebebeb]">
  <!-- Mesh Gradient Atmospheric Backdrop -->
  <div class="absolute inset-0 mesh-gradient-bg opacity-70 pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Announcement Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/80 border border-[#ebebeb] shadow-sm mb-6 text-xs text-[#4d4d4d] backdrop-blur-sm animate-fade-in">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-medium text-[#171717]">100% Free Forever</span>
      <span class="text-[#888888]">·</span>
      <span>No Registration Required</span>
      <span class="text-[#888888]">·</span>
      <span class="text-[#0070f3] font-medium">No Watermarks</span>
    </div>

    <!-- Main Headline with Negative Tracking -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[-0.04em] text-[#171717] leading-[1.1] max-w-4xl mx-auto mb-6">
      Create, sign & export professional invoices.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-[#4d4d4d] max-w-2xl mx-auto font-normal leading-relaxed mb-8">
      The fastest, cleanest invoice maker for freelancers, agencies, and businesses. Built with real-time editing, digital signature studio, payment QR codes, and instant vector PDF export.
    </p>

    <!-- CTAs & Micro-Proof -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      <a
        href="#generator-section"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium text-white bg-[#171717] hover:bg-black rounded-full shadow-md hover:shadow-lg transition-all active:scale-95"
      >
        <span>Start Invoicing Now</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>

      <a
        href="#comparison-section"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-medium text-[#171717] bg-white hover:bg-[#fafafa] border border-[#ebebeb] rounded-full shadow-sm hover:shadow transition-all"
      >
        <span>Compare vs Refrens</span>
      </a>
    </div>

    <!-- Feature Chips Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto text-xs text-[#4d4d4d]">
      <div class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-white/70 border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span class="font-medium text-[#171717]">Digital Signature Studio</span>
      </div>
      <div class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-white/70 border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span class="font-medium text-[#171717]">Instant UPI / PayPal QR</span>
      </div>
      <div class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-white/70 border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span class="font-medium text-[#171717]">100% Privacy-First Vault</span>
      </div>
      <div class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-white/70 border border-[#ebebeb] shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span class="font-medium text-[#171717]">Vector PDF & WhatsApp</span>
      </div>
    </div>
  </div>
</section>
