---
// TemplatesShowcase.astro - Showcase of 5 Modern Invoice Styles
import { THEME_PRESETS } from '../../scripts/invoice-state.js';
---

<section id="templates-section" class="py-16 md:py-24 border-t border-slate-200 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] border border-[#ebebeb] text-[11px] font-semibold text-[#4d4d4d] mb-3">
        <span>Designer Templates</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
        Curated invoice templates for every brand.
      </h2>
      <p class="text-sm sm:text-base text-slate-500 leading-relaxed">
        Choose from clean monochrome minimalism to high-contrast executive styles. Switch instantly with zero data loss.
      </p>
    </div>

    <!-- Template Grid Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {THEME_PRESETS.map((theme) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-level-2 hover:shadow-level-4 hover:border-[#171717] transition-all flex flex-col justify-between group">
          <div class="space-y-3 mb-4">
            <!-- Simulated Miniature Invoice Sheet Preview -->
            <div class="aspect-4/3 rounded-xl bg-slate-50 border border-slate-200 p-4 flex overflow-hidden shadow-sm group-hover:scale-[1.02] transition-transform">
              {theme.id === 'executive' && (
                <div class="w-1/4 bg-[#171717] rounded-lg mr-3"></div>
              )}
              <div class="flex-1 flex flex-col justify-between">
                <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                  <div class="w-12 h-3 rounded bg-slate-300"></div>
                  {theme.id === 'minimal'
                    ? <div class="w-3 h-3 rounded-full bg-[#171717]"></div>
                    : <div class="w-16 h-3 rounded" style={`background-color: ${theme.previewColor};`}></div>}
                </div>
                <div class="space-y-1.5 py-2">
                  <div class="w-full h-2 rounded bg-slate-200"></div>
                  <div class="w-3/4 h-2 rounded bg-slate-100"></div>
                  <div class="w-1/2 h-2 rounded bg-slate-100"></div>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-slate-200">
                  <div class="w-10 h-2.5 rounded bg-slate-200"></div>
                  <div class="w-12 h-3 rounded font-mono font-bold" style={`color: ${theme.previewColor};`}>$$$</div>
                </div>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-slate-900">{theme.name}</h3>
                <span class="text-[10px] font-mono text-slate-500 px-1.5 py-0.5 rounded bg-slate-100">{theme.font}</span>
              </div>
              <p class="text-xs text-slate-500 mt-1">
                {theme.id === 'gst_tally' && "Corporate GST / Tally-style layout with a bold ink header band and formal tabular line items."}
                {theme.id === 'minimal' && "Ultra-clean white minimal layout with hairline separators, built for modern agencies and freelancers."}
                {theme.id === 'executive' && "Executive split layout with a deep ink accent sidebar for premium consulting firms."}
              </p>
            </div>
          </div>

          <a
            href="#generator-section"
            class="w-full py-2 px-3 text-xs font-medium text-center text-[#171717] bg-[#f5f5f5] hover:bg-[#171717] hover:text-white rounded-xl border border-[#ebebeb] transition-all"
          >
            Use this Template →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>