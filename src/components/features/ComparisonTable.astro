---
// ComparisonTable.astro - Head-to-Head Comparison: Invoice Free Maker vs Refrens.com vs Templates
---

<section id="comparison-section" class="py-16 md:py-24 border-t border-slate-200 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 text-[11px] font-semibold text-slate-700 mb-3 shadow-sm">
        <span>Why Choose Invoice Free Maker</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
        Built to be faster, freer & better than Refrens.
      </h2>
      <p class="text-sm sm:text-base text-slate-500 leading-relaxed">
        See how Invoice Free Maker eliminates the paywalls, forced registrations, and complexity of legacy platforms.
      </p>
    </div>

    <!-- Comparison Table Container -->
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-level-2">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="py-4 px-6 text-xs font-semibold uppercase tracking-wider text-slate-500 w-1/3">Feature / Capability</th>
            <th class="py-4 px-6 text-sm font-bold text-slate-900 bg-[#f5f5f5] border-x border-[#e0e0e0] w-1/3">
              <div class="flex items-center justify-between">
                <span>Invoice Free Maker</span>
                <span class="px-2 py-0.5 text-[10px] font-mono uppercase bg-[#171717] text-white rounded">Our Platform</span>
              </div>
            </th>
            <th class="py-4 px-6 text-sm font-medium text-slate-500 w-1/3">Refrens.com</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-xs">
          <!-- Row 1: Cost & Limits -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Cost & Limits</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Monthly invoice quota and fee structure</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>100% Free Forever · Unlimited</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">No caps, no hidden tiers, no premium lockouts</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-amber-700 font-medium">
                <span>Freemium with strict limits</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1">Upsells to paid subscription for advanced tools</p>
            </td>
          </tr>

          <!-- Row 2: Account Registration -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Account Registration</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Friction before generating invoice</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Zero Registration Required</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Instant start right on the homepage</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-red-600 font-medium">
                <span>Mandatory Sign-Up / Login</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1">Requires email/phone verification to export</p>
            </td>
          </tr>

          <!-- Row 3: Signature Studio -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Digital Signature Studio</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Modes to sign your invoice legally</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>3 Modes: Draw, Cursive Type & Upload</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Smooth pen pad + 4 calligraphy typography styles</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-slate-500">
                <span>Basic static image upload only</span>
              </div>
            </td>
          </tr>

          <!-- Row 4: Instant Payment QR Codes -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Payment QR Codes</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Scannable codes on invoice for rapid collection</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>UPI, SEPA, PayPal & Custom QR</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Directly stamped onto invoice with zero fees</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-slate-500">
                <span>Requires payment gateway integration</span>
              </div>
            </td>
          </tr>

          <!-- Row 5: Data Privacy & Security -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Data Privacy & Ownership</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Where your confidential financials reside</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>100% Client-Side Private Vault</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Data never leaves your device · JSON backup export</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-slate-500">
                <span>Stored in 3rd party cloud database</span>
              </div>
            </td>
          </tr>

          <!-- Row 6: Design & Typography Quality -->
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-4 px-6 font-medium text-slate-900">
              <div>Design & PDF Rendering</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Aesthetics that represent your brand</div>
            </td>
            <td class="py-4 px-6 bg-[#fafafa] border-x border-[#e0e0e0]">
              <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Professional SaaS-Grade Design & Vector PDF</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Refrens-inspired clean layouts, crisp hairlines, no watermark</p>
            </td>
            <td class="py-4 px-6 text-slate-500">
              <div class="flex items-center gap-2 text-slate-500">
                <span>Traditional, busy invoice templates</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>